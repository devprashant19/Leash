use policy::{DenyReason, reason_code}
use std::evm::revert_error

// The errors LeashModule reverts with. Each `#[error]` struct has the standard 4-byte selector of its
// Solidity signature, so Safe clients, Viem and block explorers decode it by name.

// A refused Execute reverts with the refusal's code, the same number TryExecute returns and the CLI
// prints: `PolicyViolation(uint8)`, selector 0x3ad3ecc3. One error with a field, rather than one error
// per reason, keeps the module under the contract size limit.
#[error]
pub struct PolicyViolation { pub code: u8 }

pub fn revert_for(_ reason: DenyReason) -> ! {
    revert_error(PolicyViolation { code: reason_code(reason) })
}

// Execute after the circuit breaker tripped (TryExecute returns code 15 instead).
#[error]
pub struct CircuitTripped {}
// 0xc16b4f18

#[error]
pub struct NotAgent {}
// 0x0d9ab13f

#[error]
pub struct NotSafe {}
// 0x9dc4246e

#[error]
pub struct NotGuardian {}
// 0xef6d0f02

#[error]
pub struct SafeCallFailed {}
// 0xdc1669a6

#[error]
pub struct Reentrant {}
// 0xed3ba6a6

#[error]
pub struct InvalidExpiry {}
// 0xd36c8500

#[error]
pub struct ZeroAddress {}
// 0xd92e233d
