use policy
use policy::types::{AgentState, Calldata, Policy, Tx, Verdict, Window24}
use policy::types::{MAX_CALLDATA, TokenAmount}
use std::abi::Bytes
use std::evm::{Address, Call, Create, Ctx, Evm, Log, StorageMap, Timestamp, Wei, revert_error, wei}

pub use errors::*
pub use events::*
pub use safe::*
pub use queue_module::*

pub struct AgentConfig {
    pub active: bool,
    pub expiry: Timestamp,
    pub label: u256,
    pub max_per_tx: Wei,
    pub max_per_window: Wei,
    pub custom_fingerprint: u256,
    pub tripped: bool,
    pub denials: u32,
}
impl Copy for AgentConfig {}
impl Snapshot for AgentConfig {}

pub struct AgentLedger { pub eth_window: Window24 }
impl Copy for AgentLedger {}
impl Snapshot for AgentLedger {}

fn resolve_op(_ op_u8: u8) -> policy::types::Operation {
    match policy::types::operation_from_u8(op_u8) {
        Option::Some(o) => o,
        Option::None => policy::types::Operation::DelegateCall,
    }
}

pub msg LeashMsg {
    #[selector = sol("execute(address,uint256,bytes,uint8)")]
    Execute { to: Address, value: u256, data: Bytes, operation: u8 } -> bool,
    #[selector = sol("tryExecute(address,uint256,bytes,uint8)")]
    TryExecute { to: Address, value: u256, data: Bytes, operation: u8 } -> (bool, u8),
    #[selector = sol("preview(address,address,uint256,bytes,uint8)")]
    Preview { agent: Address, to: Address, value: u256, data: Bytes, operation: u8 } -> (
        u8,
        u256,
        u256,
    ),
    #[selector = sol("state(address)")]
    State { agent: Address } -> [u256; 52],
    #[selector = sol("pause()")]
    Pause,
    #[selector = sol("unpause()")]
    Unpause,
    #[selector = sol("setAgent(address,uint256,uint256)")]
    SetAgent { agent: Address, expiry: Timestamp, label: u256 },
    #[selector = sol("setAgentPolicy(address,uint256,uint256,uint256)")]
    SetAgentPolicy {
        agent: Address,
        max_per_tx: u256,
        max_per_window: u256,
        custom_fingerprint: u256,
    },
    #[selector = sol("revokeAgent(address)")]
    RevokeAgent { agent: Address },
    #[selector = sol("setGuardian(address)")]
    SetGuardian { guardian_addr: Address },
    #[selector = sol("fingerprint()")]
    Fingerprint -> u256,
    #[selector = sol("fingerprintOf(address)")]
    FingerprintOf { agent: Address } -> u256,
    #[selector = sol("resetBreaker(address)")]
    ResetBreaker { agent: Address },
}

pub enum ExecOutcome {
    Success,
    Denied(policy::DenyReason),
}

fn extract_selector(_ data: ref Bytes) -> u32 {
    if data.len() < 4 {
        0
    } else {
        let span = data.span()
        let b0: u32 = span.byte_at(0) as u32
        let b1: u32 = span.byte_at(1) as u32
        let b2: u32 = span.byte_at(2) as u32
        let b3: u32 = span.byte_at(3) as u32
        (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
    }
}

fn evaluate_tx(
    _ to: Address,
    _ value: u256,
    _ data: ref Bytes,
    _ operation: u8,
    _ paused: bool,
    _ cfg: ref AgentConfig,
    _ ledger: ref AgentLedger,
    _ now: Timestamp,
) -> Verdict {
    let pol = policy::config::policy_for_agent(cfg.max_per_tx, cfg.max_per_window)
    let st = AgentState {
        paused,
        tripped: cfg.tripped,
        expiry: cfg.expiry,
        eth_window: ledger.eth_window,
        last_action: Timestamp::from_seconds(0),
        action_window: Window24::empty(),
    }
    let op = resolve_op(operation)
    let cd = policy::calldata_from_bytes(data)
    let tx = Tx { to, value: wei(value), data: cd, op, now }
    policy::decide(tx, pol, st)
}

fn execute_tx(
    safe: Address,
    agent: Address,
    to: Address,
    value: u256,
    data: Bytes,
    operation: u8,
    paused: bool,
    cfg: AgentConfig,
    ledger: mut AgentLedger,
    now: Timestamp,
) -> ExecOutcome
uses (call: mut Call, log: mut Log)
{
    let verdict = evaluate_tx(to, value, data, operation, paused, cfg, ledger, now)

    match verdict {
        Verdict::Deny(r) => ExecOutcome::Denied(r),
        Verdict::Allow => {
            if value > 0 {
                policy::record_spend(mut ledger.eth_window, now, value)
            }
            let sel = extract_selector(data)
            log.emit(Allowed { agent, target: to, value, selector: sel })
            let success: bool = call
                .call(
                    addr: safe,
                    gas: 1000000,
                    value: Wei::zero(),
                    message: SafeMsg::ExecTransactionFromModule {
                        to,
                        value,
                        data: data.clone(),
                        operation,
                    },
                )
            if !success {
                revert_error(SafeCallFailed {})
            }
            ExecOutcome::Success
        },
    }
}

pub contract LeashModule uses (ctx: Ctx, call: mut Call, log: mut Log) {
    safe: Address,
    mut guardian: Address,
    mut paused: bool,
    mut locked: bool,
    mut agents: StorageMap<Address, AgentConfig>,
    mut ledgers: StorageMap<Address, AgentLedger>,

    init(_safe: Address, _guardian: Address)
    uses (mut safe, mut guardian, mut paused, mut locked)
    {
        if _safe == Address::zero() || _guardian == Address::zero() {
            revert_error(ZeroAddress {})
        }
        safe = _safe
        guardian = _guardian
        paused = false
        locked = false
    }

    recv LeashMsg {
        Pause uses (ctx, safe, guardian, mut paused, mut log) {
            let caller = ctx.caller()
            if caller != safe && caller != guardian {
                revert_error(NotGuardian {})
            }
            paused = true
            log.emit(PausedEvent { by: caller })
        }

        Unpause uses (ctx, safe, mut paused, mut log) {
            if ctx.caller() != safe {
                revert_error(NotSafe {})
            }
            paused = false
            log.emit(UnpausedEvent {})
        }

        SetAgent { agent, expiry, label } uses (ctx, safe, mut agents, mut log) {
            if ctx.caller() != safe {
                revert_error(NotSafe {})
            }
            if expiry <= ctx.timestamp() {
                revert_error(InvalidExpiry {})
            }
            agents
                .set(
                    key: agent,
                    value: AgentConfig {
                        active: true,
                        expiry,
                        label,
                        max_per_tx: Wei::zero(),
                        max_per_window: Wei::zero(),
                        custom_fingerprint: 0,
                        tripped: false,
                        denials: 0,
                    },
                )
            log.emit(AgentSet { agent, expiry })
        }

        SetAgentPolicy { agent, max_per_tx, max_per_window, custom_fingerprint }
        uses (ctx, safe, mut agents)
        {
            if ctx.caller() != safe {
                revert_error(NotSafe {})
            }
            var cfg = agents.get(key: agent)
            if !cfg.active {
                revert_error(NotAgent {})
            }
            cfg.max_per_tx = wei(max_per_tx)
            cfg.max_per_window = wei(max_per_window)
            cfg.custom_fingerprint = custom_fingerprint
            agents.set(key: agent, value: cfg)
        }

        RevokeAgent { agent } uses (ctx, safe, mut agents, mut log) {
            if ctx.caller() != safe {
                revert_error(NotSafe {})
            }
            var cfg = agents.get(key: agent)
            cfg.active = false
            agents.set(key: agent, value: cfg)
            log.emit(AgentRevoked { agent })
        }

        SetGuardian { guardian_addr } uses (ctx, safe, mut guardian, mut log) {
            if ctx.caller() != safe {
                revert_error(NotSafe {})
            }
            if guardian_addr == Address::zero() {
                revert_error(ZeroAddress {})
            }
            guardian = guardian_addr
            log.emit(GuardianSet { guardian: guardian_addr })
        }

        Fingerprint -> u256 {
            0x3efcfc58aec5d1e7e81b5bded7820ed3ed8a0e654cf4aff3bfb793a7494ae6ee
        }

        FingerprintOf { agent } -> u256 uses (agents) {
            let cfg = agents.get(key: agent)
            if cfg.custom_fingerprint != 0 {
                cfg.custom_fingerprint
            } else {
                0x3efcfc58aec5d1e7e81b5bded7820ed3ed8a0e654cf4aff3bfb793a7494ae6ee
            }
        }

        ResetBreaker { agent } uses (ctx, safe, mut agents, mut log) {
            if ctx.caller() != safe {
                revert_error(NotSafe {})
            }
            var cfg = agents.get(key: agent)
            cfg.tripped = false
            cfg.denials = 0
            agents.set(key: agent, value: cfg)
            log.emit(CircuitResetEvent { agent })
        }

        State { agent } -> [u256; 52] uses (agents, ledgers, paused) {
            let cfg = agents.get(key: agent)
            let ledger = ledgers.get(key: agent)
            let st = AgentState {
                paused,
                tripped: cfg.tripped,
                expiry: cfg.expiry,
                eth_window: ledger.eth_window,
                last_action: Timestamp::from_seconds(0),
                action_window: Window24::empty(),
            }
            policy::encoding::encode_state(st)
        }

        Preview { agent, to, value, data, operation } -> (u8, u256, u256)
        uses (ctx, paused, agents, ledgers)
        {
            let now = ctx.timestamp()
            let cfg = agents.get(key: agent)
            if !cfg.active {
                return (policy::reason_code(policy::DenyReason::SessionExpired), 0, 0)
            }
            let ledger = ledgers.get(key: agent)
            let verdict = evaluate_tx(to, value, data, operation, paused, cfg, ledger, now)
            let spent_win = policy::spent_in_window(ledger.eth_window, now)
            let max_win = if cfg.max_per_window.as_wei() > 0 {
                cfg.max_per_window.as_wei()
            } else {
                500_000_000_000_000_000
            }
            let rem_win = if max_win > spent_win {
                max_win - spent_win
            } else {
                0
            }
            let max_tx = if cfg.max_per_tx.as_wei() > 0 {
                cfg.max_per_tx.as_wei()
            } else {
                100_000_000_000_000_000
            }
            let rem_tx = if max_tx > value { max_tx - value } else { 0 }
            let code = match verdict {
                Verdict::Allow => 0,
                Verdict::Deny(r) => policy::reason_code(r),
            }
            (code, rem_tx, rem_win)
        }

        Execute { to, value, data, operation } -> bool
        uses (ctx, safe, mut call, mut log, paused, mut locked, agents, mut ledgers)
        {
            if locked {
                revert_error(Reentrant {})
            }
            locked = true

            let agent = ctx.caller()
            let cfg = agents.get(key: agent)
            if !cfg.active {
                locked = false
                revert_error(NotAgent {})
            }
            if cfg.tripped {
                locked = false
                revert_error(CircuitTripped {})
            }

            let now = ctx.timestamp()
            var ledger = ledgers.get(key: agent)
            let outcome = execute_tx(
                safe,
                agent,
                to,
                value,
                data,
                operation,
                paused,
                cfg,
                mut ledger,
                now,
            )

            locked = false
            match outcome {
                ExecOutcome::Denied(r) => {
                    revert_for(r)
                },
                ExecOutcome::Success => {
                    ledgers.set(key: agent, value: ledger)
                    true
                },
            }
        }

        TryExecute { to, value, data, operation } -> (bool, u8)
        uses (ctx, safe, mut call, mut log, paused, mut locked, mut agents, mut ledgers)
        {
            if locked {
                revert_error(Reentrant {})
            }
            locked = true

            let agent = ctx.caller()
            var cfg = agents.get(key: agent)
            if !cfg.active {
                locked = false
                revert_error(NotAgent {})
            }
            if cfg.tripped {
                locked = false
                return (false, 15)
            }

            let now = ctx.timestamp()
            var ledger = ledgers.get(key: agent)
            let outcome = execute_tx(
                safe,
                agent,
                to,
                value,
                data,
                operation,
                paused,
                cfg,
                mut ledger,
                now,
            )

            locked = false
            match outcome {
                ExecOutcome::Denied(r) => {
                    let code = policy::reason_code(r)
                    cfg.denials += 1
                    if cfg.denials >= 3 {
                        cfg.tripped = true
                        log.emit(CircuitTrippedEvent { agent })
                    }
                    agents.set(key: agent, value: cfg)
                    log.emit(Denied { agent, target: to, code })
                    (false, code)
                },
                ExecOutcome::Success => {
                    ledgers.set(key: agent, value: ledger)
                    (true, 0)
                },
            }
        }
    }
}
