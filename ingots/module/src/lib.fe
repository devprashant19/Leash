use policy
use policy::types::{AgentState, Bucket, Calldata, MAX_TOKENS, Policy, Tx, Verdict, Window24}
use policy::types::{MAX_CALLDATA, TokenAmount}
use std::abi::Bytes
use std::evm::{Address, Call, Create, Ctx, Evm, Log, StorageMap, Timestamp, Wei, revert_error, wei}

pub use errors::*
pub use events::*
pub use safe::*

pub struct AgentConfig {
    pub active: bool,
    pub expiry: Timestamp,
    pub label: u256,
    pub tripped: bool,
    pub denials: u32,
}
impl Copy for AgentConfig {}
impl Snapshot for AgentConfig {}

pub struct AgentLedger { pub eth_window: Window24, pub token_spent: [Bucket; MAX_TOKENS] }
impl Copy for AgentLedger {}
impl Snapshot for AgentLedger {}

fn resolve_op(_ op_u8: u8) -> policy::types::Operation {
    match policy::types::operation_from_u8(op_u8) {
        Option::Some(o) => o,
        Option::None => policy::types::Operation::DelegateCall,
    }
}

pub msg LeashMsg {
    #[selector = sol("execute(address,uint256,bytes,uint8)")]
    Execute { to: Address, value: u256, data: Bytes, operation: u8 } -> bool,
    #[selector = sol("tryExecute(address,uint256,bytes,uint8)")]
    TryExecute { to: Address, value: u256, data: Bytes, operation: u8 } -> (bool, u8),
    #[selector = sol("preview(address,address,uint256,bytes,uint8)")]
    Preview { agent: Address, to: Address, value: u256, data: Bytes, operation: u8 } -> (
        u8,
        u256,
        u256,
    ),
    #[selector = sol("state(address)")]
    State { agent: Address } -> [u256; 36],
    #[selector = sol("pause()")]
    Pause,
    #[selector = sol("unpause()")]
    Unpause,
    #[selector = sol("setAgent(address,uint256,uint256)")]
    SetAgent { agent: Address, expiry: Timestamp, label: u256 },
    #[selector = sol("revokeAgent(address)")]
    RevokeAgent { agent: Address },
    #[selector = sol("setGuardian(address)")]
    SetGuardian { guardian_addr: Address },
    #[selector = sol("fingerprint()")]
    Fingerprint -> u256,
    #[selector = sol("verifyFingerprint(uint256)")]
    VerifyFingerprint { expected: u256 } -> bool,
    #[selector = sol("resetBreaker(address)")]
    ResetBreaker { agent: Address },
}

fn extract_selector(_ data: ref Bytes) -> u32 {
    if data.len() < 4 {
        0
    } else {
        let span = data.span()
        let b0: u32 = span.byte_at(0) as u32
        let b1: u32 = span.byte_at(1) as u32
        let b2: u32 = span.byte_at(2) as u32
        let b3: u32 = span.byte_at(3) as u32
        (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
    }
}

fn eval_tx(
    _ to: Address,
    _ value: u256,
    _ data: ref Bytes,
    _ operation: u8,
    _ paused: bool,
    _ cfg: ref AgentConfig,
    ledger: mut AgentLedger,
    _ now: Timestamp,
    _ record: bool,
) -> (u8, Verdict) {
    let pol = policy::config::default_policy()
    var st = AgentState {
        paused,
        tripped: cfg.tripped,
        expiry: cfg.expiry,
        eth_window: ledger.eth_window,
        last_action: Timestamp::from_seconds(0),
        // Rate limiting is off in the module policy (max_actions_per_window = 0), so no action window is stored.
        action_window: ledger.eth_window,
        token_spent: ledger.token_spent,
    }
    let op = resolve_op(operation)
    let cd = policy::calldata_from_bytes(data)
    let tx = Tx { to, value: wei(value), data: cd, op, now }
    let decision = policy::decide_spend(tx, pol, st)
    let verdict = decision.verdict

    let code = match verdict {
        Verdict::Allow => {
            if record {
                policy::record_allowed(tx, decision.spend, mut st)
                ledger.eth_window = st.eth_window
                ledger.token_spent = st.token_spent
            }
            0
        },
        Verdict::Deny(r) => policy::reason_code(r),
    }

    (code, verdict)
}

// The Safe call for an allowed transaction. Callers store the updated ledger before calling this
// (checks-effects-interactions); the reentrancy lock is still held.
fn forward(
    safe: Address,
    agent: Address,
    to: Address,
    value: u256,
    data: Bytes,
    operation: u8,
) -> bool
uses (call: mut Call, log: mut Log)
{
    let sel = extract_selector(data)
    log.emit(Allowed { agent, target: to, value, selector: sel })
    let success: bool = call
        .call(
            addr: safe,
            gas: 1000000,
            value: Wei::zero(),
            message: SafeMsg::ExecTransactionFromModule {
                to,
                value,
                data: data.clone(),
                operation,
            },
        )
    if !success {
        revert_error(SafeCallFailed {})
    }
    true
}

fn require_safe(_ caller: Address, _ safe: Address) {
    if caller != safe {
        revert_error(NotSafe {})
    }
}

fn remaining(_ cap: u256, _ spent: u256) -> u256 {
    if cap > spent { cap - spent } else { 0 }
}

pub contract LeashModule uses (ctx: Ctx, call: mut Call, log: mut Log) {
    safe: Address,
    mut guardian: Address,
    mut paused: bool,
    mut locked: bool,
    mut agents: StorageMap<Address, AgentConfig>,
    mut ledgers: StorageMap<Address, AgentLedger>,

    init(_safe: Address, _guardian: Address)
    uses (mut safe, mut guardian, mut paused, mut locked)
    {
        if _safe == Address::zero() || _guardian == Address::zero() {
            revert_error(ZeroAddress {})
        }
        safe = _safe
        guardian = _guardian
        paused = false
        locked = false
    }

    recv LeashMsg {
        Pause uses (ctx, safe, guardian, mut paused, mut log) {
            let caller = ctx.caller()
            if caller != safe && caller != guardian {
                revert_error(NotGuardian {})
            }
            paused = true
            log.emit(PausedEvent { by: caller })
        }

        Unpause uses (ctx, safe, mut paused, mut log) {
            require_safe(ctx.caller(), safe)
            paused = false
            log.emit(UnpausedEvent {})
        }

        SetAgent { agent, expiry, label } uses (ctx, safe, mut agents, mut log) {
            require_safe(ctx.caller(), safe)
            if expiry <= ctx.timestamp() {
                revert_error(InvalidExpiry {})
            }
            agents
                .set(
                    key: agent,
                    value: AgentConfig { active: true, expiry, label, tripped: false, denials: 0 },
                )
            log.emit(AgentSet { agent, expiry })
        }

        RevokeAgent { agent } uses (ctx, safe, mut agents, mut log) {
            require_safe(ctx.caller(), safe)
            var cfg = agents.get(key: agent)
            cfg.active = false
            agents.set(key: agent, value: cfg)
            log.emit(AgentRevoked { agent })
        }

        SetGuardian { guardian_addr } uses (ctx, safe, mut guardian, mut log) {
            require_safe(ctx.caller(), safe)
            if guardian_addr == Address::zero() {
                revert_error(ZeroAddress {})
            }
            guardian = guardian_addr
            log.emit(GuardianSet { guardian: guardian_addr })
        }

        Fingerprint -> u256 {
            policy::config::POLICY_FINGERPRINT
        }

        VerifyFingerprint { expected } -> bool {
            expected == policy::config::POLICY_FINGERPRINT
        }

        ResetBreaker { agent } uses (ctx, safe, mut agents, mut log) {
            require_safe(ctx.caller(), safe)
            var cfg = agents.get(key: agent)
            cfg.tripped = false
            cfg.denials = 0
            agents.set(key: agent, value: cfg)
            log.emit(CircuitResetEvent { agent })
        }

        State { agent } -> [u256; 36] uses (agents, ledgers, paused) {
            let cfg = agents.get(key: agent)
            let ledger = ledgers.get(key: agent)
            var words: [u256; 36] = [0; 36]
            words[0] = if paused { 1 } else { 0 }
            words[1] = if cfg.tripped { 1 } else { 0 }
            words[2] = cfg.expiry.as_seconds()
            var b: usize = 0
            var idx: usize = 3
            while b < 24 {
                words[idx] = ledger.eth_window.buckets[b]
                idx += 1
                b += 1
            }
            words[27] = 0
            var t: usize = 0
            idx = 28
            while t < MAX_TOKENS {
                words[idx] = ledger.token_spent[t].index as u256
                idx += 1
                words[idx] = ledger.token_spent[t].amount
                idx += 1
                t += 1
            }
            words
        }

        Preview { agent, to, value, data, operation } -> (u8, u256, u256)
        uses (ctx, paused, agents, ledgers)
        {
            let now = ctx.timestamp()
            let cfg = agents.get(key: agent)
            if !cfg.active {
                return (policy::reason_code(policy::DenyReason::SessionExpired), 0, 0)
            }
            var ledger = ledgers.get(key: agent)
            let (code, _v) = eval_tx(
                to,
                value,
                data,
                operation,
                paused,
                cfg,
                mut ledger,
                now,
                record: false,
            )
            let spent_win = policy::spent_in_window(ledger.eth_window, now)
            let pol = policy::config::default_policy()
            let rem_win = remaining(pol.max_per_window.as_wei(), spent_win)
            let rem_tx = remaining(pol.max_per_tx.as_wei(), value)
            (code, rem_tx, rem_win)
        }

        // Atomic execution: evaluates the policy and, if allowed, records spend and forwards to Safe.
        // NOTE: On any policy denial, Execute reverts the EVM transaction atomically (revert_error).
        // Under EVM semantics, state changes in a reverting frame are rolled back; therefore,
        // denial counters and breaker tripping cannot persist during an Execute revert.
        // Callers desiring denial recording and auto-pause trip behavior should call TryExecute.
        Execute { to, value, data, operation } -> bool
        uses (ctx, safe, mut call, mut log, paused, mut locked, agents, mut ledgers)
        {
            if locked {
                revert_error(Reentrant {})
            }
            locked = true

            let agent = ctx.caller()
            var cfg = agents.get(key: agent)
            if !cfg.active {
                locked = false
                revert_error(NotAgent {})
            }
            if cfg.tripped {
                locked = false
                revert_error(CircuitTripped {})
            }

            let now = ctx.timestamp()
            var ledger = ledgers.get(key: agent)
            let (_code, verdict) = eval_tx(
                to,
                value,
                data,
                operation,
                paused,
                cfg,
                mut ledger,
                now,
                record: true,
            )
            match verdict {
                Verdict::Deny(r) => revert_for(r),
                Verdict::Allow => {},
            }
            ledgers.set(key: agent, value: ledger)
            let success = forward(safe, agent, to, value, data, operation)
            locked = false
            success
        }

        // Non-reverting execution: evaluates policy and returns (success, deny_code).
        // On denial, it increments cfg.denials, trips the circuit breaker if the threshold is met,
        // and emits the Denied event without reverting the EVM frame, persisting the denial state.
        TryExecute { to, value, data, operation } -> (bool, u8)
        uses (ctx, safe, mut call, mut log, paused, mut locked, mut agents, mut ledgers)
        {
            if locked {
                revert_error(Reentrant {})
            }
            locked = true

            let agent = ctx.caller()
            var cfg = agents.get(key: agent)
            if !cfg.active {
                locked = false
                revert_error(NotAgent {})
            }
            if cfg.tripped {
                locked = false
                return (false, 15)
            }

            let now = ctx.timestamp()
            var ledger = ledgers.get(key: agent)
            let (code, verdict) = eval_tx(
                to,
                value,
                data,
                operation,
                paused,
                cfg,
                mut ledger,
                now,
                record: true,
            )
            match verdict {
                Verdict::Deny(_r) => {
                    cfg.denials += 1
                    if policy::breaker_trips(cfg.denials) {
                        cfg.tripped = true
                        log.emit(CircuitTrippedEvent { agent })
                    }
                    log.emit(Denied { agent, target: to, code })
                    agents.set(key: agent, value: cfg)
                    locked = false
                    (false, code)
                },
                Verdict::Allow => {
                    ledgers.set(key: agent, value: ledger)
                    let success = forward(safe, agent, to, value, data, operation)
                    locked = false
                    (success, 0)
                },
            }
        }
    }
}
