use ingot::*
use policy::config::{ADDR_TOKEN, ADDR_TREASURY}
use std::abi::{Bytes, bytes_from_words}
use std::evm::{Address, Call, Create, Ctx, Evm, Timestamp, Wei, wei}
use testkit::{Erc20Msg, MockErc20, MockSafe, Reenterer, SafeMsg}

#[cfg(target = "evm")]
#[test]
fn test_fingerprint_golden() uses (evm: mut Evm) {
    let safe = Address::new(0x1111)
    let guardian = Address::new(0x2222)
    let module_addr = evm.create<LeashModule>(value: Wei::zero(), args: (safe, guardian))

    let fp: u256 = evm
        .call(
            addr: module_addr,
            gas: 100000,
            value: Wei::zero(),
            message: LeashMsg::Fingerprint {},
        )
    assert(
        fp == 0x3efcfc58aec5d1e7e81b5bded7820ed3ed8a0e654cf4aff3bfb793a7494ae6ee,
    )
}

#[cfg(target = "evm")]
#[test]
fn test_pause_unpause_guardian() uses (evm: mut Evm) {
    let caller = evm.address()
    let safe = Address::new(0x1111)
    let guardian = caller
    let module_addr = evm.create<LeashModule>(value: Wei::zero(), args: (safe, guardian))

    // Guardian can pause
    evm.call(
        addr: module_addr,
        gas: 100000,
        value: Wei::zero(),
        message: LeashMsg::Pause {},
    )
}

#[cfg(target = "evm")]
#[test(should_revert)]
fn test_unpause_by_non_safe_reverts() uses (evm: mut Evm) {
    let caller = evm.address()
    let safe = Address::new(0x1111)
    let guardian = caller
    let module_addr = evm.create<LeashModule>(value: Wei::zero(), args: (safe, guardian))

    // Caller is guardian, not safe. Unpause should revert NotSafe
    evm.call(
        addr: module_addr,
        gas: 100000,
        value: Wei::zero(),
        message: LeashMsg::Unpause {},
    )
}

#[cfg(target = "evm")]
#[test(should_revert)]
fn test_set_agent_by_non_safe_reverts() uses (evm: mut Evm) {
    let caller = evm.address()
    let safe = Address::new(0x1111)
    let guardian = Address::new(0x2222)
    let module_addr = evm.create<LeashModule>(value: Wei::zero(), args: (safe, guardian))

    // Caller is not safe
    evm.call(
        addr: module_addr,
        gas: 100000,
        value: Wei::zero(),
        message: LeashMsg::SetAgent {
            agent: caller,
            expiry: Timestamp::from_seconds(9999999999),
            label: 1,
        },
    )
}

#[cfg(target = "evm")]
#[test(should_revert)]
fn test_unregistered_agent_reverts() uses (evm: mut Evm) {
    let safe = Address::new(0x1111)
    let guardian = Address::new(0x2222)
    let module_addr = evm.create<LeashModule>(value: Wei::zero(), args: (safe, guardian))

    let empty_words: [u256; 0] = [0; 0]
    let empty_data: Bytes = bytes_from_words(empty_words)
    let _: bool = evm
        .call(
            addr: module_addr,
            gas: 1000000,
            value: Wei::zero(),
            message: LeashMsg::Execute {
                to: ADDR_TREASURY,
                value: 1000,
                data: empty_data,
                operation: 0,
            },
        )
}

