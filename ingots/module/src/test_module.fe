#[cfg(target = "evm")]
#[test]
fn test_try_execute_denied_returns_code() uses (evm: mut Evm) {
    let agent = evm.address()
    let safe = evm.create<MockSafe>(value: Wei::zero(), args: ())
    let guardian = Address::new(0x2222)
    let module_addr = evm.create<LeashModule>(value: Wei::zero(), args: (safe, guardian))

    evm.call(
        addr: safe,
        gas: 100000,
        value: Wei::zero(),
        message: SafeMsg::EnableModule { module_addr },
    )
    evm.call(
        addr: safe,
        gas: 100000,
        value: Wei::zero(),
        message: SafeMsg::SetAgentOn {
            module_addr,
            agent,
            expiry: Timestamp::from_seconds(9999999999),
            label: 1,
        },
    )

    let empty_words: [u256; 0] = [0; 0]
    let empty_data: Bytes = bytes_from_words(empty_words)
    let unlisted = Address::new(0x9999)
    let (success, code): (bool, u8) = evm
        .call(
            addr: module_addr,
            gas: 1000000,
            value: Wei::zero(),
            message: LeashMsg::TryExecute {
                to: unlisted,
                value: 1000,
                data: empty_data,
                operation: 0,
            },
        )
    assert(!success)
    assert(code == 4)

    let count: u256 = evm
        .call(
            addr: safe,
            gas: 100000,
            value: Wei::zero(),
            message: SafeMsg::CallCount {},
        )
    assert(count == 0)
}

