#[cfg(target = "evm")]
#[test]
fn test_preview_inactive_agent() uses (evm: mut Evm) {
    let safe = Address::new(0x1111)
    let guardian = Address::new(0x2222)
    let module_addr = evm.create<LeashModule>(value: Wei::zero(), args: (safe, guardian))

    let empty_words: [u256; 0] = [0; 0]
    let empty_data: Bytes = bytes_from_words(empty_words)
    let (code, _rem_tx, _rem_win): (u8, u256, u256) = evm
        .call(
            addr: module_addr,
            gas: 100000,
            value: Wei::zero(),
            message: LeashMsg::Preview {
                agent: Address::new(0xdead),
                to: ADDR_TREASURY,
                value: 1000,
                data: empty_data,
                operation: 0,
            },
        )
    assert(code == 2)
}

#[cfg(target = "evm")]
#[test]
fn test_execute_allowed_eth() uses (evm: mut Evm) {
    let agent = evm.address()
    let safe = evm.create<MockSafe>(value: Wei::zero(), args: ())
    let guardian = Address::new(0x2222)
    let module_addr = evm.create<LeashModule>(value: Wei::zero(), args: (safe, guardian))

    evm.call(
        addr: safe,
        gas: 100000,
        value: Wei::zero(),
        message: SafeMsg::EnableModule { module_addr },
    )
    evm.call(
        addr: safe,
        gas: 100000,
        value: Wei::zero(),
        message: SafeMsg::SetAgentOn {
            module_addr,
            agent,
            expiry: Timestamp::from_seconds(9999999999),
            label: 1,
        },
    )

    let empty_words: [u256; 0] = [0; 0]
    let empty_data: Bytes = bytes_from_words(empty_words)
    let val: u256 = 10000000000000000
    let ok: bool = evm
        .call(
            addr: module_addr,
            gas: 1000000,
            value: Wei::zero(),
            message: LeashMsg::Execute {
                to: ADDR_TREASURY,
                value: val,
                data: empty_data,
                operation: 0,
            },
        )
    assert(ok)

    let count: u256 = evm
        .call(
            addr: safe,
            gas: 100000,
            value: Wei::zero(),
            message: SafeMsg::CallCount {},
        )
    assert(count == 1)

    let last_to: Address = evm
        .call(
            addr: safe,
            gas: 100000,
            value: Wei::zero(),
            message: SafeMsg::LastTo {},
        )
    assert(last_to == ADDR_TREASURY)

    let last_val: u256 = evm
        .call(
            addr: safe,
            gas: 100000,
            value: Wei::zero(),
            message: SafeMsg::LastValue {},
        )
    assert(last_val == val)
}

