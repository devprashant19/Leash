use std::evm::Address
use std::evm::units::{Duration, Wei, ether, hours, seconds}
use ingot::types::{
    MAX_RECIPIENTS,
    MAX_SELECTORS,
    MAX_TARGETS,
    MAX_TOKENS,
    Policy,
    SEL_APPROVE,
    SEL_TRANSFER,
    SEL_TRANSFER_FROM,
    TargetKind,
    TargetRule,
    TokenAmount,
    TokenRule,
}

pub const ADDR_TOKEN: Address = Address::new(0x1000000000000000000000000000000000000001)
pub const ADDR_TREASURY: Address = Address::new(0x2000000000000000000000000000000000000002)

pub fn policy_for_agent(_ max_tx: Wei, _ max_win: Wei) -> Policy {
    var targets: [TargetRule; MAX_TARGETS] = [TargetRule::empty(); MAX_TARGETS]
    targets[0].target = ADDR_TOKEN
    targets[0].kind = TargetKind::Erc20
    targets[0].n_selectors = 3
    targets[0].selectors[0] = SEL_APPROVE
    targets[0].selectors[1] = SEL_TRANSFER_FROM
    targets[0].selectors[2] = SEL_TRANSFER

    targets[1].target = ADDR_TREASURY
    targets[1].allow_eth_transfer = true

    var tokens: [TokenRule; MAX_TOKENS] = [TokenRule::empty(); MAX_TOKENS]
    tokens[0].token = ADDR_TOKEN
    tokens[0].max_per_tx = TokenAmount::from(100_000_000_000_000_000_000)
    tokens[0].max_per_window = TokenAmount::from(500_000_000_000_000_000_000)
    tokens[0].max_approve = TokenAmount::from(100_000_000_000_000_000_000)

    let tx_cap = if max_tx.as_wei() > 0 {
        max_tx
    } else {
        ether(1) / 10
    }
    let win_cap = if max_win.as_wei() > 0 {
        max_win
    } else {
        ether(1) / 2
    }

    Policy {
        version: 1,
        n_targets: 2,
        targets,
        max_per_tx: tx_cap,
        max_per_window: win_cap,
        window: hours(24),
        n_tokens: 1,
        tokens,
        n_recipients: 0,
        recipients: [Address::zero(); MAX_RECIPIENTS],
        max_actions_per_window: 0,
        cooldown: seconds(0),
        breaker_threshold: 0,
    }
}

pub fn default_policy() -> Policy {
    policy_for_agent(max_tx: Wei::zero(), max_win: Wei::zero())
}
