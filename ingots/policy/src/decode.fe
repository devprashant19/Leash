use ingot::types::{Address, Calldata, MAX_CALLDATA, SEL_APPROVE, SEL_TRANSFER, SEL_TRANSFER_FROM}

pub enum Erc20Call {
    Transfer(Address, u256),
    Approve(Address, u256),
    TransferFrom(Address, Address, u256),
    Malformed,
    Unknown,
}

impl Copy for Erc20Call {}
impl Snapshot for Erc20Call {}

pub fn selector_of(_ data: Calldata) -> Option<u32> {
    if data.len < 4 {
        Option::None
    } else {
        let b0 = (data.bytes[0] as u32) << 24
        let b1 = (data.bytes[1] as u32) << 16
        let b2 = (data.bytes[2] as u32) << 8
        let b3 = data.bytes[3] as u32
        Option::Some(b0 | b1 | b2 | b3)
    }
}

pub fn is_address_word(bytes: [u8; MAX_CALLDATA], offset: usize) -> bool {
    var i: usize = 0
    while i < 12 {
        if bytes[offset + i] != 0 {
            return false
        }
        i += 1
    }
    true
}

pub fn read_word(bytes: [u8; MAX_CALLDATA], offset: usize) -> u256 {
    var res: u256 = 0
    var i: usize = 0
    while i < 32 {
        res = (res << 8) | (bytes[offset + i] as u256)
        i += 1
    }
    res
}

pub fn read_address(bytes: [u8; MAX_CALLDATA], offset: usize) -> Address {
    let w = read_word(bytes, offset)
    Address::from_word_truncate(w)
}

pub fn decode_erc20(_ data: Calldata) -> Erc20Call {
    if data.len < 4 {
        return Erc20Call::Malformed
    }

    let sel = match selector_of(data) {
        Option::Some(s) => s,
        Option::None => {
            return Erc20Call::Malformed
        },
    }

    if sel == SEL_TRANSFER {
        if data.len != 68 {
            return Erc20Call::Malformed
        }
        if !is_address_word(bytes: data.bytes, offset: 4) {
            return Erc20Call::Malformed
        }
        let to = read_address(bytes: data.bytes, offset: 4)
        let amt = read_word(bytes: data.bytes, offset: 36)
        Erc20Call::Transfer(to, amt)
    } else if sel == SEL_APPROVE {
        if data.len != 68 {
            return Erc20Call::Malformed
        }
        if !is_address_word(bytes: data.bytes, offset: 4) {
            return Erc20Call::Malformed
        }
        let spender = read_address(bytes: data.bytes, offset: 4)
        let amt = read_word(bytes: data.bytes, offset: 36)
        Erc20Call::Approve(spender, amt)
    } else if sel == SEL_TRANSFER_FROM {
        if data.len != 100 {
            return Erc20Call::Malformed
        }
        if !is_address_word(bytes: data.bytes, offset: 4) {
            return Erc20Call::Malformed
        }
        if !is_address_word(bytes: data.bytes, offset: 36) {
            return Erc20Call::Malformed
        }
        let from = read_address(bytes: data.bytes, offset: 4)
        let to = read_address(bytes: data.bytes, offset: 36)
        let amt = read_word(bytes: data.bytes, offset: 68)
        Erc20Call::TransferFrom(from, to, amt)
    } else {
        Erc20Call::Unknown
    }
}
