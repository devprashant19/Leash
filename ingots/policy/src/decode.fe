use ingot::types::{
    Address,
    Calldata,
    MAX_CALLDATA,
    SEL_APPROVE,
    SEL_DECREASE_ALLOWANCE,
    SEL_INCREASE_ALLOWANCE,
    SEL_TRANSFER,
    SEL_TRANSFER_FROM,
    SEL_UNISWAP_V2_SWAP_TOKENS,
    SEL_UNISWAP_V3_EXACT_INPUT_SINGLE,
}

pub enum Erc20Call {
    Transfer(Address, u256),
    Approve(Address, u256),
    TransferFrom(Address, Address, u256),
    Malformed,
    Unknown,
}

pub enum SwapCall {
    ExactInput(u256, u256),
    Malformed,
    Unknown,
}

impl Copy for SwapCall {}
impl Snapshot for SwapCall {}

impl Copy for Erc20Call {}
impl Snapshot for Erc20Call {}

pub fn selector_of(_ data: ref Calldata) -> Option<u32> {
    if data.len < 4 {
        Option::None
    } else {
        let b0 = (data.bytes[0] as u32) << 24
        let b1 = (data.bytes[1] as u32) << 16
        let b2 = (data.bytes[2] as u32) << 8
        let b3 = data.bytes[3] as u32
        Option::Some(b0 | b1 | b2 | b3)
    }
}

pub fn is_address_word(_ data: ref Calldata, offset: usize) -> bool {
    var i: usize = 0
    while i < 12 {
        if data.bytes[offset + i] != 0 {
            return false
        }
        i += 1
    }
    true
}

pub fn read_word(_ data: ref Calldata, offset: usize) -> u256 {
    var res: u256 = 0
    var i: usize = 0
    while i < 32 {
        res = (res << 8) | (data.bytes[offset + i] as u256)
        i += 1
    }
    res
}

pub fn read_address(_ data: ref Calldata, offset: usize) -> Address {
    let w = read_word(data, offset)
    Address::from_word_truncate(w)
}

pub fn decode_erc20(_ data: ref Calldata) -> Erc20Call {
    if data.len < 4 {
        return Erc20Call::Malformed
    }

    let sel = match selector_of(data) {
        Option::Some(s) => s,
        Option::None => {
            return Erc20Call::Malformed
        },
    }

    if sel == SEL_TRANSFER {
        if data.len != 68 {
            return Erc20Call::Malformed
        }
        if !is_address_word(data, offset: 4) {
            return Erc20Call::Malformed
        }
        let to = read_address(data, offset: 4)
        let amt = read_word(data, offset: 36)
        Erc20Call::Transfer(to, amt)
    } else if sel == SEL_APPROVE || sel == SEL_INCREASE_ALLOWANCE {
        if data.len != 68 {
            return Erc20Call::Malformed
        }
        if !is_address_word(data, offset: 4) {
            return Erc20Call::Malformed
        }
        let spender = read_address(data, offset: 4)
        let amt = read_word(data, offset: 36)
        Erc20Call::Approve(spender, amt)
    } else if sel == SEL_DECREASE_ALLOWANCE {
        if data.len != 68 {
            return Erc20Call::Malformed
        }
        if !is_address_word(data, offset: 4) {
            return Erc20Call::Malformed
        }
        let spender = read_address(data, offset: 4)
        Erc20Call::Approve(spender, 0)
    } else if sel == SEL_TRANSFER_FROM {
        if data.len != 100 {
            return Erc20Call::Malformed
        }
        if !is_address_word(data, offset: 4) {
            return Erc20Call::Malformed
        }
        if !is_address_word(data, offset: 36) {
            return Erc20Call::Malformed
        }
        let from = read_address(data, offset: 4)
        let to = read_address(data, offset: 36)
        let amt = read_word(data, offset: 68)
        Erc20Call::TransferFrom(from, to, amt)
    } else {
        Erc20Call::Unknown
    }
}

pub fn decode_swap(_ data: ref Calldata) -> SwapCall {
    if data.len < 4 {
        return SwapCall::Malformed
    }

    let sel = match selector_of(data) {
        Option::Some(s) => s,
        Option::None => {
            return SwapCall::Malformed
        },
    }

    if sel == SEL_UNISWAP_V2_SWAP_TOKENS || sel == SEL_UNISWAP_V3_EXACT_INPUT_SINGLE {
        if data.len < 68 {
            return SwapCall::Malformed
        }
        let amount_in = read_word(data, offset: 4)
        let amount_out_min = read_word(data, offset: 36)
        SwapCall::ExactInput(amount_in, amount_out_min)
    } else {
        SwapCall::Unknown
    }
}

pub fn calldata_from_bytes(_ b: ref core::Bytes) -> Calldata {
    let span = b.span()
    let len = span.len()
    var bytes: [u8; MAX_CALLDATA] = [0; MAX_CALLDATA]
    let copy_len = if len > MAX_CALLDATA {
        MAX_CALLDATA
    } else {
        len
    }
    var i: usize = 0
    while i < copy_len {
        bytes[i] = span.byte_at(i)
        i = i + 1
    }
    Calldata { len, bytes }
}
