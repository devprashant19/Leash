use ingot::decode::{Erc20Call, decode_erc20}
use ingot::types::{
    AgentState,
    BUCKETS,
    BUCKET_LEN,
    Bucket,
    Policy,
    TargetKind,
    Timestamp,
    Tx,
    Window24,
}

pub const U256_MAX: u256 = 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff

pub fn checked_add_saturate(_ a: u256, _ b: u256) -> u256 {
    if U256_MAX - a < b {
        U256_MAX
    } else {
        a + b
    }
}

pub fn bucket_index_of(_ now: Timestamp) -> u64 {
    (now.as_seconds() / (BUCKET_LEN as u256)).downcast_truncate()
}

pub fn spent_in_window(_ window: ref Window24, _ now: Timestamp) -> u256 {
    let current_index = bucket_index_of(now)
    let buckets_count: u64 = BUCKETS.downcast_truncate()
    var total: u256 = 0
    var i: usize = 0
    while i < BUCKETS {
        let b = window.buckets[i]
        if b.index <= current_index {
            if current_index - b.index < buckets_count {
                total = checked_add_saturate(total, b.amount)
            }
        }
        i += 1
    }
    total
}

pub fn record_spend(_ window: mut Window24, _ now: Timestamp, _ amount: u256) {
    let current_index = bucket_index_of(now)
    let buckets_count: u64 = BUCKETS.downcast_truncate()
    let slot_u64: u64 = current_index % buckets_count
    let slot: usize = slot_u64.downcast_truncate()
    if window.buckets[slot].index == current_index {
        window.buckets[slot].amount = checked_add_saturate(window.buckets[slot].amount, amount)
    } else {
        window.buckets[slot] = Bucket { index: current_index, amount }
    }
}

pub fn record(_ tx: ref Tx, _ policy: ref Policy, _ state: mut AgentState) {
    if tx.value.as_wei() > 0 {
        record_spend(mut state.eth_window, tx.now, tx.value.as_wei())
    }
    state.last_action = tx.now
}

pub fn record_denial(_ now: Timestamp, _ state: mut AgentState) {
    state.last_action = now
}
