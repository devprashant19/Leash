use ingot::outflow::TokenSpend
use ingot::rules::decide_spend
use ingot::types::{
    AgentState,
    BUCKETS,
    BUCKET_LEN,
    Bucket,
    Policy,
    TOKEN_PERIOD,
    Timestamp,
    Tx,
    Window24,
}

pub const U256_MAX: u256 = 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
pub const ETH_AMOUNT_MAX: u256 = 0x0000000000000000ffffffffffffffffffffffffffffffffffffffffffffffff

pub fn checked_add_saturate(_ a: u256, _ b: u256) -> u256 {
    if U256_MAX - a < b { U256_MAX } else { a + b }
}

pub fn checked_add_saturate_192(_ a: u256, _ b: u256) -> u256 {
    let safe_a = if a > ETH_AMOUNT_MAX {
        ETH_AMOUNT_MAX
    } else {
        a
    }
    if ETH_AMOUNT_MAX - safe_a < b {
        ETH_AMOUNT_MAX
    } else {
        safe_a + b
    }
}

pub fn pack_bucket(_ index: u64, _ amount: u256) -> u256 {
    let sat_amount = if amount > ETH_AMOUNT_MAX {
        ETH_AMOUNT_MAX
    } else {
        amount
    }
    ((index as u256) << 192) | sat_amount
}

pub fn unpack_bucket_index(_ packed: u256) -> u64 {
    (packed >> 192).downcast_truncate()
}

pub fn unpack_bucket_amount(_ packed: u256) -> u256 {
    packed & ETH_AMOUNT_MAX
}

pub fn bucket_index_of(_ now: Timestamp) -> u64 {
    (now.as_seconds() / (BUCKET_LEN as u256)).downcast_truncate()
}

pub fn spent_in_window(_ window: ref Window24, _ now: Timestamp) -> u256 {
    let current_index = bucket_index_of(now)
    let buckets_count: u64 = BUCKETS.downcast_truncate()
    var total: u256 = 0
    var i: usize = 0
    while i < BUCKETS {
        let packed = window.buckets[i]
        let b_index = unpack_bucket_index(packed)
        let b_amount = unpack_bucket_amount(packed)
        if b_index <= current_index {
            if current_index - b_index < buckets_count {
                total = checked_add_saturate_192(total, b_amount)
            }
        }
        i += 1
    }
    total
}

pub fn record_spend(_ window: mut Window24, _ now: Timestamp, _ amount: u256) {
    let current_index = bucket_index_of(now)
    let buckets_count: u64 = BUCKETS.downcast_truncate()
    let slot_u64: u64 = current_index % buckets_count
    let slot: usize = slot_u64.downcast_truncate()
    let packed = window.buckets[slot]
    let b_index = unpack_bucket_index(packed)
    if b_index == current_index {
        let cur_amount = unpack_bucket_amount(packed)
        let new_amount = checked_add_saturate_192(cur_amount, amount)
        window.buckets[slot] = pack_bucket(current_index, new_amount)
    } else {
        window.buckets[slot] = pack_bucket(current_index, checked_add_saturate_192(0, amount))
    }
}

pub fn period_index_of(_ now: Timestamp) -> u64 {
    (now.as_seconds() / (TOKEN_PERIOD as u256)).downcast_truncate()
}

// Tokens moved in the TOKEN_PERIOD that contains `now` (0 once the period has passed).
pub fn token_spent_in_period(_ bucket: Bucket, _ now: Timestamp) -> u256 {
    if bucket.index == period_index_of(now) {
        bucket.amount
    } else {
        0
    }
}

pub fn add_token_spend(_ bucket: Bucket, _ now: Timestamp, _ amount: u256) -> Bucket {
    let period = period_index_of(now)
    if bucket.index == period {
        Bucket { index: period, amount: checked_add_saturate(bucket.amount, amount) }
    } else {
        Bucket { index: period, amount }
    }
}

// Books an allowed call: its ETH, the tokens decide_spend found it moves, one action, the time.
pub fn record_allowed(_ tx: ref Tx, _ spend: Option<TokenSpend>, _ state: mut AgentState) {
    if tx.value.as_wei() > 0 {
        record_spend(mut state.eth_window, tx.now, tx.value.as_wei())
    }
    if let Option::Some(s) = spend {
        state.token_spent[s.idx] = add_token_spend(state.token_spent[s.idx], tx.now, s.amount)
    }
    record_spend(mut state.action_window, tx.now, 1)
    state.last_action = tx.now
}

// Books a call that decide allowed. The token amount comes from the same decision, so the check and
// the ledger never read the calldata differently.
pub fn record(_ tx: ref Tx, _ policy: ref Policy, _ state: mut AgentState) {
    let spend = decide_spend(tx, policy, state).spend
    record_allowed(tx, spend, mut state)
}

pub fn record_denial(_ now: Timestamp, _ state: mut AgentState) {
    state.last_action = now
}
