use ingot::decode::{AaveCall, Erc20Call, decode_aave, decode_erc20, selector_of}
use ingot::ledger::{U256_MAX, checked_add_saturate, spent_in_window, token_spent_in_period}
use ingot::outflow::{TokenSpend, find_target_idx, find_token_rule_idx}
use ingot::types::{
    Address,
    AgentState,
    DenyReason,
    Duration,
    Operation,
    Policy,
    PriceQuote,
    TargetKind,
    TargetRule,
    Timestamp,
    Tx,
    Verdict,
    Wei,
}

fn check_selector_and_calldata(_ tx: ref Tx, _ target: ref TargetRule) -> Option<DenyReason> {
    if tx.data.len == 0 {
        if target.allow_eth_transfer {
            Option::None
        } else {
            Option::Some(DenyReason::SelectorNotAllowed)
        }
    } else if tx.data.len < 4 {
        Option::Some(DenyReason::MalformedCalldata)
    } else {
        let sel = match selector_of(tx.data) {
            Option::Some(s) => s,
            Option::None => {
                return Option::Some(DenyReason::MalformedCalldata)
            },
        }
        var found = false
        var i: usize = 0
        while i < (target.n_selectors as usize) {
            if target.selectors[i] == sel {
                found = true
                break
            }
            i += 1
        }
        if found {
            Option::None
        } else {
            Option::Some(DenyReason::SelectorNotAllowed)
        }
    }
}

fn is_recipient_allowed(_ addr: Address, _ policy: ref Policy) -> bool {
    if policy.n_recipients == 0 {
        return true
    }
    var r: usize = 0
    while r < (policy.n_recipients as usize) {
        if policy.recipients[r] == addr {
            return true
        }
        r += 1
    }
    false
}

// What a protocol guard found: nothing to object to, tokens leaving under a token rule, or a refusal.
pub enum GuardCheck {
    Pass,
    Spend(TokenSpend),
    Fail(DenyReason),
}

impl Copy for GuardCheck {}
impl Snapshot for GuardCheck {}

fn guard_reason(_ c: GuardCheck) -> Option<DenyReason> {
    match c {
        GuardCheck::Fail(r) => Option::Some(r),
        _ => Option::None,
    }
}

// Tokens leaving under token rule `idx`: recipient (11), per-transfer cap (9), then the 24 h period cap (21).
fn check_transfer(
    _ to: Address,
    _ amt: u256,
    _ idx: usize,
    _ policy: ref Policy,
    _ state: ref AgentState,
    _ now: Timestamp,
) -> GuardCheck {
    let token_rule = ref policy.tokens[idx]
    if !is_recipient_allowed(to, policy) {
        GuardCheck::Fail(DenyReason::RecipientNotAllowed)
    } else if amt > token_rule.max_per_tx.as_u256() {
        GuardCheck::Fail(DenyReason::TokenCapExceeded)
    } else if checked_add_saturate(token_spent_in_period(state.token_spent[idx], now), amt)
        > token_rule.max_per_window.as_u256() {
        GuardCheck::Fail(DenyReason::TokenWindowCapExceeded)
    } else {
        GuardCheck::Spend(TokenSpend { idx, amount: amt })
    }
}

fn erc20_check(_ tx: ref Tx, _ policy: ref Policy, _ state: ref AgentState) -> GuardCheck {
    let token_idx = match find_token_rule_idx(token: tx.to, policy) {
        Option::Some(idx) => idx,
        Option::None => {
            return GuardCheck::Fail(DenyReason::TokenCapExceeded)
        },
    }
    let token_rule = ref policy.tokens[token_idx]

    match decode_erc20(tx.data) {
        Erc20Call::Malformed => GuardCheck::Fail(DenyReason::MalformedCalldata),
        Erc20Call::Unknown => GuardCheck::Fail(DenyReason::SelectorNotAllowed),
        Erc20Call::Transfer(to, amt) => check_transfer(
            to,
            amt,
            idx: token_idx,
            policy,
            state,
            now: tx.now,
        ),
        Erc20Call::TransferFrom(_from, to, amt) => {
            check_transfer(to, amt, idx: token_idx, policy, state, now: tx.now)
        },
        Erc20Call::Approve(spender, amt) => {
            if amt == 0 {
                GuardCheck::Pass
            } else if !is_recipient_allowed(spender, policy) {
                GuardCheck::Fail(DenyReason::RecipientNotAllowed)
            } else if amt == U256_MAX || amt > token_rule.max_approve.as_u256() {
                GuardCheck::Fail(DenyReason::UnlimitedApproval)
            } else {
                GuardCheck::Pass
            }
        },
    }
}

fn aave_check(_ tx: ref Tx, _ policy: ref Policy, _ state: ref AgentState) -> GuardCheck {
    match decode_aave(tx.data) {
        AaveCall::Malformed => GuardCheck::Fail(DenyReason::MalformedCalldata),
        AaveCall::Unknown => GuardCheck::Fail(DenyReason::LendingNotAllowed),
        AaveCall::Withdraw(asset, amount, to) => {
            match find_token_rule_idx(token: asset, policy) {
                Option::Some(idx) => check_transfer(
                    to,
                    amt: amount,
                    idx,
                    policy,
                    state,
                    now: tx.now,
                ),
                Option::None => GuardCheck::Fail(DenyReason::LendingNotAllowed),
            }
        },
    }
}

pub fn check_erc20_guard(_ tx: ref Tx, _ policy: ref Policy, _ state: ref AgentState) -> Option<
    DenyReason,
> {
    guard_reason(erc20_check(tx, policy, state))
}

// Swaps are refused. The recipient and the token path of a Uniswap call lie past the 100 calldata
// bytes the policy decodes, so the policy cannot check where the output goes: default deny.
pub fn check_uniswap_guard(_ tx: ref Tx, _ policy: ref Policy, _ state: ref AgentState) -> Option<
    DenyReason,
> {
    Option::Some(DenyReason::SwapNotAllowed)
}

pub fn check_aave_guard(_ tx: ref Tx, _ policy: ref Policy, _ state: ref AgentState) -> Option<
    DenyReason,
> {
    guard_reason(aave_check(tx, policy, state))
}

// Consecutive refused tryExecute calls that trip an agent's circuit breaker (until the Safe resets it).
pub const BREAKER_DENIALS: u32 = 3

pub fn breaker_trips(_ denials: u32) -> bool {
    denials >= BREAKER_DENIALS
}

// A verdict, and for an allowed call the tokens it moves under a token rule (what `record_allowed` books).
pub struct Decision { pub verdict: Verdict, pub spend: Option<TokenSpend> }

impl Copy for Decision {}
impl Snapshot for Decision {}

fn denied(_ reason: DenyReason) -> Decision {
    Decision { verdict: Verdict::Deny(reason), spend: Option::None }
}

pub fn decide(_ tx: ref Tx, _ policy: ref Policy, _ state: ref AgentState) -> Verdict {
    decide_spend(tx, policy, state).verdict
}

// The rules, in order. Pure: same inputs, same decision. Anything not allowlisted is denied.
pub fn decide_spend(_ tx: ref Tx, _ policy: ref Policy, _ state: ref AgentState) -> Decision {
    // 1. Paused
    if state.paused {
        return denied(DenyReason::Paused)
    }

    // 2. CircuitTripped
    if state.tripped {
        return denied(DenyReason::CircuitTripped)
    }

    // 3. SessionExpired
    if state.expiry.as_seconds() > 0 {
        if tx.now >= state.expiry {
            return denied(DenyReason::SessionExpired)
        }
    }

    // 4. CooldownActive
    if policy.cooldown.as_seconds() > 0 {
        if state.last_action.as_seconds() > 0 {
            if tx.now < state.last_action + policy.cooldown {
                return denied(DenyReason::CooldownActive)
            }
        }
    }

    // 5. DelegateCallBlocked
    match tx.op {
        Operation::DelegateCall => {
            return denied(DenyReason::DelegateCallBlocked)
        },
        Operation::Call => {},
    }

    // 6. TargetNotAllowed
    let target_idx = match find_target_idx(to: tx.to, policy) {
        Option::Some(idx) => idx,
        Option::None => {
            return denied(DenyReason::TargetNotAllowed)
        },
    }

    // 7. MalformedCalldata / SelectorNotAllowed
    let tr = ref policy.targets[target_idx]
    if let Option::Some(reason) = check_selector_and_calldata(tx, target: tr) {
        return denied(reason)
    }

    // 8. RateLimited
    if policy.max_actions_per_window > 0 {
        let count = spent_in_window(state.action_window, tx.now)
        if count + 1 > (policy.max_actions_per_window as u256) {
            return denied(DenyReason::RateLimited)
        }
    }

    // 9. PerTxCapExceeded
    if tx.value > policy.max_per_tx {
        return denied(DenyReason::PerTxCapExceeded)
    }

    // 10. WindowCapExceeded
    let spent = spent_in_window(state.eth_window, tx.now)
    let total = checked_add_saturate(spent, tx.value.as_wei())
    if total > policy.max_per_window.as_wei() {
        return denied(DenyReason::WindowCapExceeded)
    }

    // 11. Protocol guards: ERC-20 and Aave (recipient, token caps 9 and 21, approvals), Uniswap (refused)
    let check = match policy.targets[target_idx].kind {
        TargetKind::Erc20 => erc20_check(tx, policy, state),
        TargetKind::UniswapRouter => GuardCheck::Fail(DenyReason::SwapNotAllowed),
        TargetKind::AavePool => aave_check(tx, policy, state),
        _ => GuardCheck::Pass,
    }
    match check {
        GuardCheck::Fail(reason) => denied(reason),
        GuardCheck::Spend(s) => Decision { verdict: Verdict::Allow, spend: Option::Some(s) },
        GuardCheck::Pass => Decision { verdict: Verdict::Allow, spend: Option::None },
    }
}

pub fn decide_with_escalation(
    _ tx: ref Tx,
    _ policy: ref Policy,
    _ state: ref AgentState,
    _ escalation_threshold: Wei,
) -> Verdict {
    let outcome = decide(tx, policy, state)
    match outcome {
        Verdict::Allow => {
            if escalation_threshold > Wei::zero() && tx.value > escalation_threshold {
                Verdict::Deny(DenyReason::EscalationRequired)
            } else {
                Verdict::Allow
            }
        },
        Verdict::Deny(r) => Verdict::Deny(r),
    }
}

pub fn decide_with_usd(
    _ tx: ref Tx,
    _ policy: ref Policy,
    _ state: ref AgentState,
    _ price_quote: Option<PriceQuote>,
    _ max_usd_per_tx: u256,
    _ max_price_age: Duration,
) -> Verdict {
    let outcome = decide(tx, policy, state)
    match outcome {
        Verdict::Allow => {
            if max_usd_per_tx > 0 {
                let pq = match price_quote {
                    Option::Some(q) => q,
                    Option::None => {
                        return Verdict::Deny(DenyReason::PriceUnavailable)
                    },
                }
                if pq.usd_per_eth_1e8 == 0 {
                    return Verdict::Deny(DenyReason::PriceUnavailable)
                }
                if tx.now < pq.updated_at {
                    return Verdict::Deny(DenyReason::PriceUnavailable)
                }
                if tx.now > pq.updated_at + max_price_age {
                    return Verdict::Deny(DenyReason::PriceUnavailable)
                }
                let usd_val = (tx.value.as_wei() * pq.usd_per_eth_1e8) / 1000000000000000000
                if usd_val > max_usd_per_tx {
                    return Verdict::Deny(DenyReason::UsdCapExceeded)
                }
            }
            Verdict::Allow
        },
        Verdict::Deny(r) => Verdict::Deny(r),
    }
}
