use ingot::decode::{
    AaveCall,
    Erc20Call,
    SwapCall,
    decode_aave,
    decode_erc20,
    decode_swap,
    selector_of,
}
use ingot::ledger::{U256_MAX, checked_add_saturate, spent_in_window}
use ingot::types::{
    Address,
    AgentState,
    DenyReason,
    Duration,
    Operation,
    Policy,
    PriceQuote,
    TargetKind,
    TargetRule,
    TokenRule,
    Tx,
    Verdict,
    Wei,
}

fn find_target_idx(_ to: Address, _ policy: ref Policy) -> Option<usize> {
    if to == Address::zero() {
        return Option::None
    }
    var i: usize = 0
    while i < (policy.n_targets as usize) {
        if policy.targets[i].target == to {
            return Option::Some(i)
        }
        i += 1
    }
    Option::None
}

fn check_selector_and_calldata(_ tx: ref Tx, _ target: ref TargetRule) -> Option<DenyReason> {
    if tx.data.len == 0 {
        if target.allow_eth_transfer {
            Option::None
        } else {
            Option::Some(DenyReason::SelectorNotAllowed)
        }
    } else if tx.data.len < 4 {
        Option::Some(DenyReason::MalformedCalldata)
    } else {
        let sel = match selector_of(tx.data) {
            Option::Some(s) => s,
            Option::None => {
                return Option::Some(DenyReason::MalformedCalldata)
            },
        }
        var found = false
        var i: usize = 0
        while i < (target.n_selectors as usize) {
            if target.selectors[i] == sel {
                found = true
                break
            }
            i += 1
        }
        if found {
            Option::None
        } else {
            Option::Some(DenyReason::SelectorNotAllowed)
        }
    }
}

fn find_token_rule_idx(_ token: Address, _ policy: ref Policy) -> Option<usize> {
    var i: usize = 0
    while i < (policy.n_tokens as usize) {
        if policy.tokens[i].token == token {
            return Option::Some(i)
        }
        i += 1
    }
    Option::None
}

fn is_recipient_allowed(_ addr: Address, _ policy: ref Policy) -> bool {
    if policy.n_recipients == 0 {
        return true
    }
    var r: usize = 0
    while r < (policy.n_recipients as usize) {
        if policy.recipients[r] == addr {
            return true
        }
        r += 1
    }
    false
}

fn check_transfer(
    _ to: Address,
    _ amt: u256,
    _ token_rule: ref TokenRule,
    _ policy: ref Policy,
) -> Option<DenyReason> {
    if !is_recipient_allowed(to, policy) {
        Option::Some(DenyReason::RecipientNotAllowed)
    } else if amt > token_rule.max_per_tx.as_u256() {
        Option::Some(DenyReason::TokenCapExceeded)
    } else {
        Option::None
    }
}

pub fn check_erc20_guard(_ tx: ref Tx, _ policy: ref Policy, _ state: ref AgentState) -> Option<
    DenyReason,
> {
    let token_idx = match find_token_rule_idx(token: tx.to, policy) {
        Option::Some(idx) => idx,
        Option::None => {
            return Option::Some(DenyReason::TokenCapExceeded)
        },
    }
    let token_rule = ref policy.tokens[token_idx]

    match decode_erc20(tx.data) {
        Erc20Call::Malformed => Option::Some(DenyReason::MalformedCalldata),
        Erc20Call::Unknown => Option::Some(DenyReason::SelectorNotAllowed),
        Erc20Call::Transfer(to, amt) => check_transfer(to, amt, token_rule, policy),
        Erc20Call::TransferFrom(_from, to, amt) => check_transfer(to, amt, token_rule, policy),
        Erc20Call::Approve(spender, amt) => {
            if amt == 0 {
                Option::None
            } else {
                if !is_recipient_allowed(spender, policy) {
                    return Option::Some(DenyReason::RecipientNotAllowed)
                }
                if amt == U256_MAX || amt > token_rule.max_approve.as_u256() {
                    Option::Some(DenyReason::UnlimitedApproval)
                } else {
                    Option::None
                }
            }
        },
    }
}

pub fn check_uniswap_guard(_ tx: ref Tx, _ policy: ref Policy, _ state: ref AgentState) -> Option<
    DenyReason,
> {
    match decode_swap(tx.data) {
        SwapCall::Malformed => Option::Some(DenyReason::MalformedCalldata),
        SwapCall::Unknown => Option::Some(DenyReason::SwapNotAllowed),
        SwapCall::ExactInput(amount_in, amount_out_min) => {
            // MEV Sandwich Protection: Zero minimum output is strictly forbidden
            if amount_out_min == 0 {
                return Option::Some(DenyReason::SwapNotAllowed)
            }

            // Check input token caps if tokens are listed in policy
            if policy.n_tokens > 0 {
                if amount_in > policy.tokens[0].max_per_tx.as_u256() {
                    return Option::Some(DenyReason::TokenCapExceeded)
                }
            }
            Option::None
        },
    }
}

pub fn check_aave_guard(_ tx: ref Tx, _ policy: ref Policy, _ state: ref AgentState) -> Option<
    DenyReason,
> {
    match decode_aave(tx.data) {
        AaveCall::Malformed => Option::Some(DenyReason::MalformedCalldata),
        AaveCall::Unknown => Option::Some(DenyReason::LendingNotAllowed),
        AaveCall::Withdraw(asset, amount, to) => {
            let tr_idx = match find_token_rule_idx(token: asset, policy) {
                Option::Some(idx) => idx,
                Option::None => {
                    return Option::Some(DenyReason::LendingNotAllowed)
                },
            }
            let token_rule = ref policy.tokens[tr_idx]
            check_transfer(to, amt: amount, token_rule, policy)
        },
    }
}

pub fn decide(_ tx: ref Tx, _ policy: ref Policy, _ state: ref AgentState) -> Verdict {
    // 1. Paused
    if state.paused {
        return Verdict::Deny(DenyReason::Paused)
    }

    // 2. CircuitTripped
    if state.tripped {
        return Verdict::Deny(DenyReason::CircuitTripped)
    }

    // 3. SessionExpired
    if state.expiry.as_seconds() > 0 {
        if tx.now >= state.expiry {
            return Verdict::Deny(DenyReason::SessionExpired)
        }
    }

    // 4. CooldownActive
    if policy.cooldown.as_seconds() > 0 {
        if state.last_action.as_seconds() > 0 {
            if tx.now < state.last_action + policy.cooldown {
                return Verdict::Deny(DenyReason::CooldownActive)
            }
        }
    }

    // 5. DelegateCallBlocked
    match tx.op {
        Operation::DelegateCall => {
            return Verdict::Deny(DenyReason::DelegateCallBlocked)
        },
        Operation::Call => {},
    }

    // 6. TargetNotAllowed
    let target_idx = match find_target_idx(to: tx.to, policy) {
        Option::Some(idx) => idx,
        Option::None => {
            return Verdict::Deny(DenyReason::TargetNotAllowed)
        },
    }

    // 7. MalformedCalldata / SelectorNotAllowed
    let tr = ref policy.targets[target_idx]
    if let Option::Some(reason) = check_selector_and_calldata(tx, target: tr) {
        return Verdict::Deny(reason)
    }

    // 8. RateLimited
    if policy.max_actions_per_window > 0 {
        let count = spent_in_window(state.action_window, tx.now)
        if count + 1 > (policy.max_actions_per_window as u256) {
            return Verdict::Deny(DenyReason::RateLimited)
        }
    }

    // 9. PerTxCapExceeded
    if tx.value > policy.max_per_tx {
        return Verdict::Deny(DenyReason::PerTxCapExceeded)
    }

    // 10. WindowCapExceeded
    let spent = spent_in_window(state.eth_window, tx.now)
    let total = checked_add_saturate(spent, tx.value.as_wei())
    if total > policy.max_per_window.as_wei() {
        return Verdict::Deny(DenyReason::WindowCapExceeded)
    }

    // 11. Protocol guards (ERC-20, Uniswap Router)
    match policy.targets[target_idx].kind {
        TargetKind::Erc20 => {
            if let Option::Some(reason) = check_erc20_guard(tx, policy, state) {
                return Verdict::Deny(reason)
            }
        },
        TargetKind::UniswapRouter => {
            if let Option::Some(reason) = check_uniswap_guard(tx, policy, state) {
                return Verdict::Deny(reason)
            }
        },
        TargetKind::AavePool => {
            if let Option::Some(reason) = check_aave_guard(tx, policy, state) {
                return Verdict::Deny(reason)
            }
        },
        _ => {},
    }

    Verdict::Allow
}

pub fn check_erc20_guard_override(
    _ tx: ref Tx,
    _ policy: ref Policy,
    _ state: ref AgentState,
) -> Option<DenyReason> {
    match decode_erc20(tx.data) {
        Erc20Call::Malformed => Option::Some(DenyReason::MalformedCalldata),
        Erc20Call::Unknown => Option::Some(DenyReason::SelectorNotAllowed),
        Erc20Call::Transfer(to, _amt) => {
            if !is_recipient_allowed(to, policy) {
                Option::Some(DenyReason::RecipientNotAllowed)
            } else {
                Option::None
            }
        },
        Erc20Call::TransferFrom(_from, to, _amt) => {
            if !is_recipient_allowed(to, policy) {
                Option::Some(DenyReason::RecipientNotAllowed)
            } else {
                Option::None
            }
        },
        Erc20Call::Approve(spender, amt) => {
            if amt == 0 {
                Option::None
            } else {
                if !is_recipient_allowed(spender, policy) {
                    return Option::Some(DenyReason::RecipientNotAllowed)
                }
                if amt == U256_MAX {
                    Option::Some(DenyReason::UnlimitedApproval)
                } else {
                    Option::None
                }
            }
        },
    }
}

pub fn check_uniswap_guard_override(
    _ tx: ref Tx,
    _ policy: ref Policy,
    _ state: ref AgentState,
) -> Option<DenyReason> {
    match decode_swap(tx.data) {
        SwapCall::Malformed => Option::Some(DenyReason::MalformedCalldata),
        SwapCall::Unknown => Option::Some(DenyReason::SwapNotAllowed),
        SwapCall::ExactInput(_amount_in, amount_out_min) => {
            if amount_out_min == 0 {
                return Option::Some(DenyReason::SwapNotAllowed)
            }
            Option::None
        },
    }
}

pub fn decide_with_override(
    _ tx: ref Tx,
    _ policy: ref Policy,
    _ state: ref AgentState,
) -> Verdict {
    // 1. Paused
    if state.paused {
        return Verdict::Deny(DenyReason::Paused)
    }

    // 2. CircuitTripped
    if state.tripped {
        return Verdict::Deny(DenyReason::CircuitTripped)
    }

    // 3. SessionExpired
    if state.expiry.as_seconds() > 0 {
        if tx.now >= state.expiry {
            return Verdict::Deny(DenyReason::SessionExpired)
        }
    }

    // 4. CooldownActive
    if policy.cooldown.as_seconds() > 0 {
        if state.last_action.as_seconds() > 0 {
            if tx.now < state.last_action + policy.cooldown {
                return Verdict::Deny(DenyReason::CooldownActive)
            }
        }
    }

    // 5. DelegateCallBlocked
    match tx.op {
        Operation::DelegateCall => {
            return Verdict::Deny(DenyReason::DelegateCallBlocked)
        },
        Operation::Call => {},
    }

    // 6. TargetNotAllowed
    let target_idx = match find_target_idx(to: tx.to, policy) {
        Option::Some(idx) => idx,
        Option::None => {
            return Verdict::Deny(DenyReason::TargetNotAllowed)
        },
    }

    // 7. MalformedCalldata / SelectorNotAllowed
    let tr = ref policy.targets[target_idx]
    if let Option::Some(reason) = check_selector_and_calldata(tx, target: tr) {
        return Verdict::Deny(reason)
    }

    // 8. RateLimited
    if policy.max_actions_per_window > 0 {
        let count = spent_in_window(state.action_window, tx.now)
        if count + 1 > (policy.max_actions_per_window as u256) {
            return Verdict::Deny(DenyReason::RateLimited)
        }
    }

    // Notice: 9. PerTxCapExceeded and 10. WindowCapExceeded are skipped with valid owner override!

    // 11. Protocol guards (with token caps skipped)
    match policy.targets[target_idx].kind {
        TargetKind::Erc20 => {
            if let Option::Some(reason) = check_erc20_guard_override(tx, policy, state) {
                return Verdict::Deny(reason)
            }
        },
        TargetKind::UniswapRouter => {
            if let Option::Some(reason) = check_uniswap_guard_override(tx, policy, state) {
                return Verdict::Deny(reason)
            }
        },
        _ => {},
    }

    Verdict::Allow
}

pub fn decide_with_escalation(
    _ tx: ref Tx,
    _ policy: ref Policy,
    _ state: ref AgentState,
    _ escalation_threshold: Wei,
) -> Verdict {
    let outcome = decide(tx, policy, state)
    match outcome {
        Verdict::Allow => {
            if escalation_threshold > Wei::zero() && tx.value > escalation_threshold {
                Verdict::Deny(DenyReason::EscalationRequired)
            } else {
                Verdict::Allow
            }
        },
        Verdict::Deny(r) => Verdict::Deny(r),
    }
}

pub fn decide_with_usd(
    _ tx: ref Tx,
    _ policy: ref Policy,
    _ state: ref AgentState,
    _ price_quote: Option<PriceQuote>,
    _ max_usd_per_tx: u256,
    _ max_price_age: Duration,
) -> Verdict {
    let outcome = decide(tx, policy, state)
    match outcome {
        Verdict::Allow => {
            if max_usd_per_tx > 0 {
                let pq = match price_quote {
                    Option::Some(q) => q,
                    Option::None => {
                        return Verdict::Deny(DenyReason::PriceUnavailable)
                    },
                }
                if pq.usd_per_eth_1e8 == 0 {
                    return Verdict::Deny(DenyReason::PriceUnavailable)
                }
                if tx.now < pq.updated_at {
                    return Verdict::Deny(DenyReason::PriceUnavailable)
                }
                if tx.now > pq.updated_at + max_price_age {
                    return Verdict::Deny(DenyReason::PriceUnavailable)
                }
                let usd_val = (tx.value.as_wei() * pq.usd_per_eth_1e8) / 1000000000000000000
                if usd_val > max_usd_per_tx {
                    return Verdict::Deny(DenyReason::UsdCapExceeded)
                }
            }
            Verdict::Allow
        },
        Verdict::Deny(r) => Verdict::Deny(r),
    }
}
