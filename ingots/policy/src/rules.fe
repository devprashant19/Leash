use ingot::decode::selector_of
use ingot::guard::{
    AaveGuard,
    ActionGuard,
    Erc20Guard,
    GuardCheck,
    UniswapGuard,
    check_aave_guard,
    check_erc20_guard,
    check_uniswap_guard,
    dispatch_action_guard,
    guard_reason,
}
use ingot::ledger::{U256_MAX, checked_add_saturate, spent_in_window}
use ingot::outflow::{TokenSpend, find_target_idx}
use ingot::types::{
    Address,
    AgentState,
    DenyReason,
    Duration,
    Operation,
    Policy,
    PriceQuote,
    TargetKind,
    TargetRule,
    Timestamp,
    Tx,
    Verdict,
    Wei,
}

fn check_selector_and_calldata(_ tx: ref Tx, _ target: ref TargetRule) -> Option<DenyReason> {
    if tx.data.len == 0 {
        if target.allow_eth_transfer {
            Option::None
        } else {
            Option::Some(DenyReason::SelectorNotAllowed)
        }
    } else if tx.data.len < 4 {
        Option::Some(DenyReason::MalformedCalldata)
    } else {
        let sel = match selector_of(tx.data) {
            Option::Some(s) => s,
            Option::None => {
                return Option::Some(DenyReason::MalformedCalldata)
            },
        }
        var found = false
        var i: usize = 0
        while i < (target.n_selectors as usize) {
            if target.selectors[i] == sel {
                found = true
                break
            }
            i += 1
        }
        if found {
            Option::None
        } else {
            Option::Some(DenyReason::SelectorNotAllowed)
        }
    }
}

// Refused tryExecute calls that trip an agent's circuit breaker. Allowed calls in between do not reset
// the count; only the Safe's ResetBreaker does.
pub const BREAKER_DENIALS: u32 = 3

pub fn breaker_trips(_ denials: u32) -> bool {
    denials >= BREAKER_DENIALS
}

// A verdict, and for an allowed call the tokens it moves under a token rule (what `record_allowed` books).
pub struct Decision { pub verdict: Verdict, pub spend: Option<TokenSpend> }

impl Copy for Decision {}
impl Snapshot for Decision {}

fn denied(_ reason: DenyReason) -> Decision {
    Decision { verdict: Verdict::Deny(reason), spend: Option::None }
}

pub fn decide(_ tx: ref Tx, _ policy: ref Policy, _ state: ref AgentState) -> Verdict {
    decide_spend(tx, policy, state).verdict
}

// The rules, in order. Pure: same inputs, same decision. Anything not allowlisted is denied.
pub fn decide_spend(_ tx: ref Tx, _ policy: ref Policy, _ state: ref AgentState) -> Decision {
    // 1. Paused
    if state.paused {
        return denied(DenyReason::Paused)
    }

    // 2. CircuitTripped
    if state.tripped {
        return denied(DenyReason::CircuitTripped)
    }

    // 3. SessionExpired
    if state.expiry.as_seconds() > 0 {
        if tx.now >= state.expiry {
            return denied(DenyReason::SessionExpired)
        }
    }

    // 4. CooldownActive
    if policy.cooldown.as_seconds() > 0 {
        if state.last_action.as_seconds() > 0 {
            if tx.now < state.last_action + policy.cooldown {
                return denied(DenyReason::CooldownActive)
            }
        }
    }

    // 5. DelegateCallBlocked
    match tx.op {
        Operation::DelegateCall => {
            return denied(DenyReason::DelegateCallBlocked)
        },
        Operation::Call => {},
    }

    // 6. TargetNotAllowed
    let target_idx = match find_target_idx(to: tx.to, policy) {
        Option::Some(idx) => idx,
        Option::None => {
            return denied(DenyReason::TargetNotAllowed)
        },
    }

    // 7. MalformedCalldata / SelectorNotAllowed
    let tr = ref policy.targets[target_idx]
    if let Option::Some(reason) = check_selector_and_calldata(tx, target: tr) {
        return denied(reason)
    }

    // 8. RateLimited
    if policy.max_actions_per_window > 0 {
        let count = spent_in_window(state.action_window, tx.now)
        if count + 1 > (policy.max_actions_per_window as u256) {
            return denied(DenyReason::RateLimited)
        }
    }

    // 9. PerTxCapExceeded
    if tx.value > policy.max_per_tx {
        return denied(DenyReason::PerTxCapExceeded)
    }

    // 10. WindowCapExceeded
    let spent = spent_in_window(state.eth_window, tx.now)
    let total = checked_add_saturate(spent, tx.value.as_wei())
    if total > policy.max_per_window.as_wei() {
        return denied(DenyReason::WindowCapExceeded)
    }

    // 11. Protocol guards dispatched via ActionGuard trait (Erc20Guard, UniswapGuard, AaveGuard)
    let check = dispatch_action_guard(kind: policy.targets[target_idx].kind, tx, policy, state)
    match check {
        GuardCheck::Fail(reason) => denied(reason),
        GuardCheck::Spend(s) => Decision { verdict: Verdict::Allow, spend: Option::Some(s) },
        GuardCheck::Pass => Decision { verdict: Verdict::Allow, spend: Option::None },
    }
}

pub fn decide_with_escalation(
    _ tx: ref Tx,
    _ policy: ref Policy,
    _ state: ref AgentState,
    _ escalation_threshold: Wei,
) -> Verdict {
    let outcome = decide(tx, policy, state)
    match outcome {
        Verdict::Allow => {
            if escalation_threshold > Wei::zero() && tx.value > escalation_threshold {
                Verdict::Deny(DenyReason::EscalationRequired)
            } else {
                Verdict::Allow
            }
        },
        Verdict::Deny(r) => Verdict::Deny(r),
    }
}

pub fn decide_with_usd(
    _ tx: ref Tx,
    _ policy: ref Policy,
    _ state: ref AgentState,
    _ price_quote: Option<PriceQuote>,
    _ max_usd_per_tx: u256,
    _ max_price_age: Duration,
) -> Verdict {
    let outcome = decide(tx, policy, state)
    match outcome {
        Verdict::Allow => {
            if max_usd_per_tx > 0 {
                let pq = match price_quote {
                    Option::Some(q) => q,
                    Option::None => {
                        return Verdict::Deny(DenyReason::PriceUnavailable)
                    },
                }
                if pq.usd_per_eth_1e8 == 0 {
                    return Verdict::Deny(DenyReason::PriceUnavailable)
                }
                if tx.now < pq.updated_at {
                    return Verdict::Deny(DenyReason::PriceUnavailable)
                }
                // Compared as a difference, so an `updated_at` near the top of the range cannot overflow.
                if tx.now.as_seconds() - pq.updated_at.as_seconds() > max_price_age.as_seconds() {
                    return Verdict::Deny(DenyReason::PriceUnavailable)
                }
                // A value whose USD amount would overflow is above any cap: refuse it rather than panic.
                let wei_value = tx.value.as_wei()
                if wei_value > 0 && pq.usd_per_eth_1e8 > U256_MAX / wei_value {
                    return Verdict::Deny(DenyReason::UsdCapExceeded)
                }
                let usd_val = (wei_value * pq.usd_per_eth_1e8) / 1000000000000000000
                if usd_val > max_usd_per_tx {
                    return Verdict::Deny(DenyReason::UsdCapExceeded)
                }
            }
            Verdict::Allow
        },
        Verdict::Deny(r) => Verdict::Deny(r),
    }
}
