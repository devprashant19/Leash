use ingot::config::{ADDR_TOKEN, ADDR_TREASURY, default_policy}
use ingot::ledger::{
    bucket_index_of,
    record,
    record_denial,
    record_spend,
    spent_in_window,
}
use ingot::types::{
    AgentState,
    BUCKET_LEN,
    Calldata,
    Operation,
    SEL_TRANSFER,
    Timestamp,
    Tx,
    Window24,
}
use std::evm::units::{ether, seconds, wei}

fn make_transfer_calldata(to: ingot::types::Address, amt: u256) -> Calldata {
    var cd = Calldata::empty()
    cd.len = 68
    cd.bytes[0] = (SEL_TRANSFER >> 24).downcast_truncate()
    cd.bytes[1] = (SEL_TRANSFER >> 16).downcast_truncate()
    cd.bytes[2] = (SEL_TRANSFER >> 8).downcast_truncate()
    cd.bytes[3] = (SEL_TRANSFER).downcast_truncate()

    let to_w = to.word()
    var i: usize = 0
    while i < 32 {
        let shift = ((31 - i) * 8) as u256
        cd.bytes[4 + i] = ((to_w >> shift) & 0xff).downcast_truncate()
        i += 1
    }

    var j: usize = 0
    while j < 32 {
        let shift = ((31 - j) * 8) as u256
        cd.bytes[36 + j] = ((amt >> shift) & 0xff).downcast_truncate()
        j += 1
    }
    cd
}

#[test]
fn test_bucket_index_calculation() {
    let t0 = Timestamp::from_seconds(0)
    let t3599 = Timestamp::from_seconds(3599)
    let t3600 = Timestamp::from_seconds(3600)
    let t7199 = Timestamp::from_seconds(7199)
    let t7200 = Timestamp::from_seconds(7200)
    let t24 = Timestamp::from_seconds(24 * 3600)

    assert(bucket_index_of(t0) == 0)
    assert(bucket_index_of(t3599) == 0)
    assert(bucket_index_of(t3600) == 1)
    assert(bucket_index_of(t7199) == 1)
    assert(bucket_index_of(t7200) == 2)
    assert(bucket_index_of(t24) == 24)
}

#[test]
fn test_single_and_multiple_spends_same_bucket() {
    var win = Window24::empty()
    let now = Timestamp::from_seconds(100)

    assert(spent_in_window(win, now) == 0)

    record_spend(mut win, now, 500)
    assert(spent_in_window(win, now) == 500)

    record_spend(mut win, now, 250)
    assert(spent_in_window(win, now) == 750)
}

#[test]
fn test_rolling_window_24h_rollover_exact() {
    var win = Window24::empty()
    let t_hour0 = Timestamp::from_seconds(10)
    let cap: u256 = 1_000_000

    // Spend cap at hour 0
    record_spend(mut win, t_hour0, cap)
    assert(spent_in_window(win, t_hour0) == cap)

    // At last second of bucket 23 (23 * 3600 + 3599 = 86399)
    let t_hour23_end = Timestamp::from_seconds(86399)
    assert(spent_in_window(win, t_hour23_end) == cap)

    // At first second of bucket 24 (24 * 3600 = 86400)
    let t_hour24_start = Timestamp::from_seconds(86400)
    assert(spent_in_window(win, t_hour24_start) == 0)
}

#[test]
fn test_25h_gap_full_reset() {
    var win = Window24::empty()
    let t0 = Timestamp::from_seconds(1000)
    record_spend(mut win, t0, 50_000)

    // 25 hours later (25 * 3600 = 90000)
    let t_25h = Timestamp::from_seconds(1000 + 90000)
    assert(spent_in_window(win, t_25h) == 0)
}

#[test]
fn test_record_eth_spend() {
    let policy = default_policy()
    var state = AgentState::empty()
    let now = Timestamp::from_seconds(500)
    let tx = Tx {
        to: ADDR_TREASURY,
        value: ether(1) / 100,
        // 0.01 ETH
        data: Calldata::empty(),
        op: Operation::Call,
        now,
    }

    record(tx, policy, mut state)
    assert(
        spent_in_window(state.eth_window, now) == (ether(1) / 100).as_wei(),
    )
    assert(state.last_action == now)
}

#[test]
fn test_record_denial_counter() {
    var state = AgentState::empty()
    let now = Timestamp::from_seconds(800)
    record_denial(now, mut state)
    assert(state.last_action == now)
}
