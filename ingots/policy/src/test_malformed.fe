#[test]
fn test_robustness_dirty_address_word() {
    let policy = default_policy()
    let state = AgentState::empty()
    var data = make_transfer_calldata(to: ADDR_TOKEN, amt: 100)
    data.bytes[4] = 0x01 // dirty byte in high 12 bytes

    let tx = Tx {
        to: ADDR_TOKEN,
        value: wei(0),
        data,
        op: Operation::Call,
        now: Timestamp::from_seconds(100),
    }

    match decide(tx, policy, state) {
        Verdict::Deny(reason) => match reason {
            DenyReason::MalformedCalldata => {},
            _ => assert(false),
        },
        _ => assert(false),
    }
}

#[test]
fn test_robustness_amount_u256_max() {
    let policy = default_policy()
    let state = AgentState::empty()
    let data = make_transfer_calldata(to: ADDR_TOKEN, amt: U256_MAX)

    let tx = Tx {
        to: ADDR_TOKEN,
        value: wei(0),
        data,
        op: Operation::Call,
        now: Timestamp::from_seconds(100),
    }

    match decide(tx, policy, state) {
        Verdict::Deny(reason) => match reason {
            DenyReason::TokenCapExceeded => {},
            _ => assert(false),
        },
        _ => assert(false),
    }
}

#[test]
fn test_robustness_value_u256_max_no_overflow_panic() {
    let policy = default_policy()
    let state = AgentState::empty()

    let tx = Tx {
        to: ADDR_TOKEN,
        value: wei(U256_MAX),
        data: Calldata::empty(),
        op: Operation::Call,
        now: Timestamp::from_seconds(100),
    }

    match decide(tx, policy, state) {
        Verdict::Deny(reason) => match reason {
            DenyReason::SelectorNotAllowed => {},
            _ => assert(false),
        },
        _ => assert(false),
    }
}
