use ingot::config::{ADDR_TOKEN, ADDR_TREASURY, default_policy}
use ingot::ledger::record_spend
use ingot::rules::decide
use ingot::types::{
    Address,
    AgentState,
    Calldata,
    DenyReason,
    MAX_CALLDATA,
    MAX_TARGETS,
    MAX_TOKENS,
    Operation,
    Policy,
    Timestamp,
    Tx,
    Verdict,
}
use std::evm::units::{ether, seconds, wei}

#[test]
fn test_allow_valid_eth_transfer() {
    let policy = default_policy()
    let state = AgentState::empty()
    let tx = Tx {
        to: ADDR_TREASURY,
        value: ether(1) / 20,
        // 0.05 ETH <= 0.1 ETH cap
        data: Calldata::empty(),
        op: Operation::Call,
        now: Timestamp::from_seconds(100),
    }

    match decide(tx, policy, state) {
        Verdict::Allow => {},
        _ => assert(false),
    }
}

#[test]
fn test_deny_paused() {
    let policy = default_policy()
    var state = AgentState::empty()
    state.paused = true

    let tx = Tx {
        to: ADDR_TREASURY,
        value: wei(1),
        data: Calldata::empty(),
        op: Operation::Call,
        now: Timestamp::from_seconds(100),
    }

    match decide(tx, policy, state) {
        Verdict::Deny(reason) => match reason {
            DenyReason::Paused => {},
            _ => assert(false),
        },
        _ => assert(false),
    }
}

#[test]
fn test_deny_session_expired() {
    let policy = default_policy()
    var state = AgentState::empty()
    state.expiry = Timestamp::from_seconds(500)

    let tx = Tx {
        to: ADDR_TREASURY,
        value: wei(1),
        data: Calldata::empty(),
        op: Operation::Call,
        now: Timestamp::from_seconds(501),
    }

    match decide(tx, policy, state) {
        Verdict::Deny(reason) => match reason {
            DenyReason::SessionExpired => {},
            _ => assert(false),
        },
        _ => assert(false),
    }
}

