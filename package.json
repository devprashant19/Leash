{
  "name": "leash-web",
  "version": "0.1.0",
  "private": true,
  "description": "Vercel page for Leash: runs the Fe-compiled contracts in an in-memory EVM and the Fe-built leash CLI for predictions.",
  "license": "Apache-2.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "sync:web": "node scripts/sync-web-assets.mjs",
    "check:web": "node scripts/sync-web-assets.mjs --check",
    "typecheck:web": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json",
    "test:web": "tsx test/web/web_test.ts",
    "build:web": "node scripts/build-web.mjs",
    "dev:web": "node scripts/dev-vite.mjs"
  },
  "dependencies": {
    "@ethereumjs/block": "10.1.3",
    "@ethereumjs/common": "10.1.3",
    "@ethereumjs/tx": "10.1.3",
    "@ethereumjs/util": "10.1.3",
    "@ethereumjs/vm": "10.1.3",
    "viem": "2.57.19"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@types/node": "22.15.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "lenis": "1.3.27",
    "motion": "12.43.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vite": "6.4.5"
  }
}
