use policy::{
    Address,
    AgentState,
    Calldata,
    DenyReason,
    Operation,
    Timestamp,
    Tx,
    Verdict,
    Wei,
    decide,
    default_policy,
    ether,
    record,
}
use testkit::addr_treasury

#[test]
pub fn test_attack_02_split_transfers_evading_window() {
    let pol = default_policy()
    // max_per_tx is 0.1 ETH, max_per_window is 0.5 ETH
    var state = AgentState::empty()
    state.expiry = Timestamp::from_seconds(2_000_000_000)

    let to = addr_treasury()
    let now = Timestamp::from_seconds(1_763_000_000)

    // Attacker sends 5 transactions of 0.09 ETH each = 0.45 ETH
    var i: u32 = 0
    while i < 5 {
        let tx = Tx {
            to,
            value: ether(9) / 100,
            // 0.09 ETH
            data: Calldata::empty(),
            op: Operation::Call,
            now,
        }
        match decide(tx, pol, state) {
            Verdict::Allow => {
                record(tx, pol, state: mut state)
            },
            _ => assert(false),
        }
        i += 1
    }

    // 6th transaction of 0.09 ETH would bring cumulative spend to 0.54 ETH > 0.5 ETH window cap!
    let tx_fail = Tx {
        to,
        value: ether(9) / 100,
        data: Calldata::empty(),
        op: Operation::Call,
        now,
    }

    match decide(tx: tx_fail, pol, state) {
        Verdict::Deny(reason) => {
            match reason {
                DenyReason::WindowCapExceeded => {},
                _ => assert(false),
            }
        },
        _ => assert(false),
    }
}
