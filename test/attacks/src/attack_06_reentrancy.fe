use module::{LeashModule, LeashMsg}
use testkit::{MockSafe, Reenterer, SafeMsg, addr_treasury}
use std::abi::{Bytes, bytes_from_words}
use std::evm::{Address, Evm, Timestamp, Wei}

#[cfg(target = "evm")]
#[test(should_revert, selector = 0xed3ba6a6)]
pub fn test_attack_06_reentrancy_rejected() uses (evm: mut Evm) {
    let agent = evm.address()
    let safe = evm.create<MockSafe>(value: Wei::zero(), args: ())
    let guardian = Address::new(0x2222)
    let module_addr = evm.create<LeashModule>(value: Wei::zero(), args: (safe, guardian))
    let reenterer = evm.create<Reenterer>(value: Wei::zero(), args: (module_addr,))

    evm.call(
        addr: safe,
        gas: 100000,
        value: Wei::zero(),
        message: SafeMsg::EnableModule { module_addr },
    )
    evm.call(
        addr: safe,
        gas: 100000,
        value: Wei::zero(),
        message: SafeMsg::SetForwardCalls { forward: false },
    )
    evm.call(
        addr: safe,
        gas: 100000,
        value: Wei::zero(),
        message: SafeMsg::SetAgentOn {
            module_addr,
            agent,
            expiry: Timestamp::from_seconds(9999999999),
            label: 1,
        },
    )
    evm.call(
        addr: safe,
        gas: 100000,
        value: Wei::zero(),
        message: SafeMsg::SetAgentOn {
            module_addr,
            agent: reenterer,
            expiry: Timestamp::from_seconds(9999999999),
            label: 2,
        },
    )
    // Safe invokes reenterer when executing transaction from module
    evm.call(
        addr: safe,
        gas: 100000,
        value: Wei::zero(),
        message: SafeMsg::SetReenterTarget { target: reenterer },
    )

    let empty_words: [u256; 0] = [0; 0]
    let empty_data: Bytes = bytes_from_words(empty_words)

    // Execute call to allowed treasury -> Safe invokes reenterer -> reenterer calls Execute -> reverts Reentrant (0xed3ba6a6)
    evm.call(
        addr: module_addr,
        gas: 1000000,
        value: Wei::zero(),
        message: LeashMsg::Execute {
            to: addr_treasury(),
            value: 1000,
            data: empty_data,
            operation: 0,
        },
    )
}
