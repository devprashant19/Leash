use module::{LeashModule, LeashMsg}
use std::abi::{Bytes, bytes_from_words}
use std::evm::{Address, Evm, Timestamp, Wei}
use testkit::{MockSafe, SafeMsg, addr_treasury}

// Selectors:
// NotSafe: 0x9dc4246e
// NotGuardian: 0xef6d0f02
// NotAgent: 0x0d9ab13f
// InvalidExpiry: 0xd36c8500

#[cfg(target = "evm")]
#[test(should_revert, selector = 0x9dc4246e)]
pub fn test_attack_08_guardian_cannot_set_agent() uses (evm: mut Evm) {
    let caller = evm.address()
    let safe = Address::new(0x1111)
    let guardian = caller
    let module_addr = evm.create<LeashModule>(value: Wei::zero(), args: (safe, guardian))

    // Guardian attempts to call setAgent: reverts NotSafe (0x9dc4246e)
    evm.call(
        addr: module_addr,
        gas: 200000,
        value: Wei::zero(),
        message: LeashMsg::SetAgent {
            agent: caller,
            expiry: Timestamp::from_seconds(2_000_000_000),
            label: 0xbeef,
        },
    )
}

#[cfg(target = "evm")]
#[test(should_revert, selector = 0x9dc4246e)]
pub fn test_attack_08_guardian_cannot_unpause() uses (evm: mut Evm) {
    let caller = evm.address()
    let safe = Address::new(0x1111)
    let guardian = caller
    let module_addr = evm.create<LeashModule>(value: Wei::zero(), args: (safe, guardian))

    // Guardian attempts to call unpause: reverts NotSafe (0x9dc4246e)
    evm.call(
        addr: module_addr,
        gas: 200000,
        value: Wei::zero(),
        message: LeashMsg::Unpause {},
    )
}

