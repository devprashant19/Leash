use module::{LeashModule, LeashMsg}
use testkit::{MockSafe, SafeMsg, addr_treasury}
use std::abi::{Bytes, bytes_from_words}
use std::evm::{Address, Evm, Timestamp, Wei}

#[cfg(target = "evm")]
#[test]
pub fn test_attack_12_circuit_breaker_trips_and_blocks_probing()
uses (evm: mut Evm)
{
    let agent = evm.address()
    let safe_addr = evm.create<MockSafe>(value: Wei::zero(), args: ())
    let guardian_addr = Address::new(0x2222)

    let module_addr = evm.create<LeashModule>(value: Wei::zero(), args: (safe_addr, guardian_addr))

    evm.call(
        addr: safe_addr,
        gas: 200000,
        value: Wei::zero(),
        message: SafeMsg::EnableModule { module_addr },
    )

    evm.call(
        addr: safe_addr,
        gas: 200000,
        value: Wei::zero(),
        message: SafeMsg::SetAgentOn {
            module_addr,
            agent,
            expiry: Timestamp::from_seconds(2_000_000_000),
            label: 0x1,
        },
    )

    // Attacker sends 3 denied calls (target not allowed)
    let bad_target = Address::new(0xdead)
    var i: u32 = 0
    while i < 3 {
        let empty_words: [u256; 0] = [0; 0]
        let empty_data: Bytes = bytes_from_words(empty_words)
        let (ok, code): (bool, u8) = evm
            .call(
                addr: module_addr,
                gas: 300000,
                value: Wei::zero(),
                message: LeashMsg::TryExecute {
                    to: bad_target,
                    value: 0,
                    data: empty_data,
                    operation: 0,
                },
            )
        assert(!ok)
        assert(code == 4) // TargetNotAllowed
        i += 1
    }

    // 4th call: even a valid transfer to treasury is now blocked with code 15 (CircuitTripped)!
    let empty_words4: [u256; 0] = [0; 0]
    let empty_data4: Bytes = bytes_from_words(empty_words4)
    let (ok4, code_tripped): (bool, u8) = evm
        .call(
            addr: module_addr,
            gas: 300000,
            value: Wei::zero(),
            message: LeashMsg::TryExecute {
                to: addr_treasury(),
                value: 1000,
                data: empty_data4,
                operation: 0,
            },
        )
    assert(!ok4)
    assert(code_tripped == 15) // CircuitTripped
}
