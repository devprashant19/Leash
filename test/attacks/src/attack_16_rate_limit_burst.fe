use policy::{
    Address,
    AgentState,
    Calldata,
    DenyReason,
    Operation,
    Timestamp,
    Tx,
    Verdict,
    Wei,
    decide,
    default_policy,
    record,
}
use testkit::addr_treasury

#[test]
pub fn test_attack_16_rate_limit_burst() {
    var pol = default_policy()
    // Configure rate limit: maximum 3 transactions per 24h window
    pol.max_actions_per_window = 3

    var state = AgentState::empty()
    state.expiry = Timestamp::from_seconds(2_000_000_000)

    let to = addr_treasury()
    let now = Timestamp::from_seconds(1_763_000_000)

    // Attacker sends 3 valid transactions of 0.01 ETH
    var i: u32 = 0
    while i < 3 {
        let tx = Tx {
            to,
            value: Wei::zero(),
            data: Calldata::empty(),
            op: Operation::Call,
            now: Timestamp::from_seconds(now.as_seconds() + (i as u256)),
        }
        match decide(tx, pol, state) {
            Verdict::Allow => {
                record(tx, pol, state: mut state)
            },
            _ => assert(false),
        }
        i += 1
    }

    // 4th transaction within the same window exceeds rate limit -> Denied (RateLimited)
    let tx_excess = Tx {
        to,
        value: Wei::zero(),
        data: Calldata::empty(),
        op: Operation::Call,
        now: Timestamp::from_seconds(now.as_seconds() + 10),
    }

    match decide(tx: tx_excess, pol, state) {
        Verdict::Deny(reason) => {
            match reason {
                DenyReason::RateLimited => {},
                _ => assert(false),
            }
        },
        _ => assert(false),
    }
}
