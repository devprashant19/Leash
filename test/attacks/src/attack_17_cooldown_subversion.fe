use policy::{
    Address,
    AgentState,
    Calldata,
    DenyReason,
    Operation,
    Timestamp,
    Tx,
    Verdict,
    Wei,
    decide,
    default_policy,
    record,
    seconds,
}
use testkit::addr_treasury

#[test]
pub fn test_attack_17_cooldown_subversion() {
    var pol = default_policy()
    // Configure cooldown: minimum 60 seconds between transactions
    pol.cooldown = seconds(60)

    var state = AgentState::empty()
    state.expiry = Timestamp::from_seconds(2_000_000_000)

    let to = addr_treasury()
    let t0 = Timestamp::from_seconds(1_763_000_000)

    // First transaction executes at t0
    let tx1 = Tx { to, value: Wei::zero(), data: Calldata::empty(), op: Operation::Call, now: t0 }
    match decide(tx: tx1, pol, state) {
        Verdict::Allow => {
            record(tx: tx1, pol, state: mut state)
        },
        _ => assert(false),
    }

    // Attacker attempts transaction 59 seconds later (< 60s cooldown) -> Denied (CooldownActive)
    let tx_fast = Tx {
        to,
        value: Wei::zero(),
        data: Calldata::empty(),
        op: Operation::Call,
        now: Timestamp::from_seconds(t0.as_seconds() + 59),
    }
    match decide(tx: tx_fast, pol, state) {
        Verdict::Deny(reason) => {
            match reason {
                DenyReason::CooldownActive => {},
                _ => assert(false),
            }
        },
        _ => assert(false),
    }

    // Boundary: transaction exactly 60 seconds later (>= 60s cooldown) -> Allowed
    let tx_ok = Tx {
        to,
        value: Wei::zero(),
        data: Calldata::empty(),
        op: Operation::Call,
        now: Timestamp::from_seconds(t0.as_seconds() + 60),
    }
    match decide(tx: tx_ok, pol, state) {
        Verdict::Allow => {},
        _ => assert(false),
    }
}
