use policy::{
    AgentState,
    Operation,
    SEL_UNISWAP_V2_SWAP_TOKENS,
    SEL_UNISWAP_V3_EXACT_INPUT_SINGLE,
    TargetKind,
    TargetRule,
    Timestamp,
    Tx,
    Wei,
    decide,
    default_policy,
    verdict_code,
}
use testkit::{addr_uniswap_router, uniswap_v2_swap, uniswap_v3_exact_input_single}

// A zero-slippage swap is the classic sandwich setup. The policy cannot see a swap's recipient or
// token path inside its 100-byte calldata window, so every call to a listed router is refused (16),
// whatever its slippage settings.
#[test]
pub fn test_attack_19_mev_zero_slippage_sandwich() {
    var pol = default_policy()
    let router = addr_uniswap_router()
    var selectors: [u32; 8] = [0; 8]
    selectors[0] = SEL_UNISWAP_V2_SWAP_TOKENS
    selectors[1] = SEL_UNISWAP_V3_EXACT_INPUT_SINGLE
    pol.targets[1] = TargetRule {
        target: router,
        kind: TargetKind::UniswapRouter,
        allow_eth_transfer: false,
        delegate_ok: false,
        n_selectors: 2,
        selectors,
    }
    pol.n_targets = 2
    var state = AgentState::empty()
    state.expiry = Timestamp::from_seconds(2_000_000_000)
    let now = Timestamp::from_seconds(1_763_000_000)

    let zero_v2 = Tx {
        to: router,
        value: Wei::zero(),
        data: uniswap_v2_swap(amount_in: 1000, amount_out_min: 0),
        op: Operation::Call,
        now,
    }
    assert(verdict_code(decide(zero_v2, pol, state)) == 16)
    let zero_v3 = Tx {
        to: router,
        value: Wei::zero(),
        data: uniswap_v3_exact_input_single(amount_in: 1000, amount_out_min: 0),
        op: Operation::Call,
        now,
    }
    assert(verdict_code(decide(zero_v3, pol, state)) == 16)
    let tight_v2 = Tx {
        to: router,
        value: Wei::zero(),
        data: uniswap_v2_swap(amount_in: 500, amount_out_min: 490),
        op: Operation::Call,
        now,
    }
    assert(verdict_code(decide(tight_v2, pol, state)) == 16)
}
