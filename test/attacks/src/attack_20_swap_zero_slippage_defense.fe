use policy::{
    Address,
    AgentState,
    Operation,
    SEL_UNISWAP_V3_EXACT_INPUT_SINGLE,
    TargetKind,
    TargetRule,
    Timestamp,
    Tx,
    Wei,
    decide,
    default_policy,
    verdict_code,
}
use testkit::{addr_attacker, addr_uniswap_router, uniswap_v3_exact_input_single}

// A swap whose output goes to the attacker looks like any other swap in the first 100 calldata bytes.
// Listed routers are refused (16), and an unlisted router is refused as an unknown target (4).
#[test]
pub fn test_attack_20_swap_zero_slippage_defense() {
    var pol = default_policy()
    let router = addr_uniswap_router()
    var selectors: [u32; 8] = [0; 8]
    selectors[0] = SEL_UNISWAP_V3_EXACT_INPUT_SINGLE
    pol.targets[1] = TargetRule {
        target: router,
        kind: TargetKind::UniswapRouter,
        allow_eth_transfer: false,
        delegate_ok: false,
        n_selectors: 1,
        selectors,
    }
    pol.n_targets = 2
    var state = AgentState::empty()
    state.expiry = Timestamp::from_seconds(2_000_000_000)
    let now = Timestamp::from_seconds(1_763_000_000)
    let swap = uniswap_v3_exact_input_single(amount_in: 500, amount_out_min: 495)

    let listed = Tx { to: router, value: Wei::zero(), data: swap, op: Operation::Call, now }
    assert(verdict_code(decide(listed, pol, state)) == 16)
    let unlisted: Address = addr_attacker()
    let other = Tx { to: unlisted, value: Wei::zero(), data: swap, op: Operation::Call, now }
    assert(verdict_code(decide(other, pol, state)) == 4)
}
