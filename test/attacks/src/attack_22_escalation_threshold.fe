use policy::{
    AgentState,
    Calldata,
    Operation,
    Tx,
    decide_with_escalation,
    default_policy,
    ether,
    verdict_code,
}
use std::evm::units::Timestamp
use testkit::fixtures::addr_treasury

// An agent asks for one payment above the escalation threshold: it is refused
// with EscalationRequired (20), while a payment under the threshold still goes through.
#[test]
fn test_attack_22_escalation_threshold() {
    let pol = default_policy()
    let state = AgentState::empty()
    let now = Timestamp::from_seconds(1000)
    let threshold = ether(1) / 20 // 0.05 ETH

    let large = Tx {
        to: addr_treasury(),
        value: ether(7) / 100,
        data: Calldata::empty(),
        op: Operation::Call,
        now,
    }
    assert(
        verdict_code(
                decide_with_escalation(
                    tx: large,
                    policy: pol,
                    state,
                    escalation_threshold: threshold,
                ),
            )
            == 20,
    )

    let small = Tx {
        to: addr_treasury(),
        value: ether(1) / 50,
        data: Calldata::empty(),
        op: Operation::Call,
        now,
    }
    assert(
        verdict_code(
                decide_with_escalation(
                    tx: small,
                    policy: pol,
                    state,
                    escalation_threshold: threshold,
                ),
            )
            == 0,
    )
}
