use policy::{
    AgentState,
    Calldata,
    DenyReason,
    Operation,
    PriceQuote,
    Timestamp,
    Tx,
    Verdict,
    Wei,
    decide_with_usd,
    default_policy,
}
use std::evm::units::{Timestamp, ether, seconds, wei}
use testkit::addr_treasury

#[test]
pub fn test_attack_24_oracle_staleness_and_usd_caps() {
    let pol = default_policy()
    let treasury = addr_treasury()

    var state = AgentState::empty()
    state.expiry = Timestamp::from_seconds(2_000_000_000)

    let now_ts = Timestamp::from_seconds(1_763_000_000)
    let max_usd: u256 = 10_000_00000000 // $10,000 with 8 decimals
    let max_age = seconds(3600)

    // 1. Attack: Oracle price is stale (> 3600 seconds old) -> PriceUnavailable (code 18)
    let stale_quote = Option::Some(
        PriceQuote {
            usd_per_eth_1e8: 3000_00000000,
            // 3000 USD/ETH
            updated_at: Timestamp::from_seconds(1_763_000_000 - 3601),
        },
    )

    let tx_eth = Tx {
        to: treasury,
        value: ether(1) / 100,
        // 0.01 ETH
        data: Calldata::empty(),
        op: Operation::Call,
        now: now_ts,
    }

    match decide_with_usd(
        tx: tx_eth,
        policy: pol,
        state,
        price_quote: stale_quote,
        max_usd_per_tx: max_usd,
        max_price_age: max_age,
    ) {
        Verdict::Deny(reason) => {
            match reason {
                DenyReason::PriceUnavailable => {},
                _ => assert(false),
            }
        },
        _ => assert(false),
    }

    // 2. Attack: Missing/corrupted price feed (None or 0 price) -> PriceUnavailable (code 18)
    let zero_quote = Option::Some(PriceQuote { usd_per_eth_1e8: 0, updated_at: now_ts })

    match decide_with_usd(
        tx: tx_eth,
        policy: pol,
        state,
        price_quote: zero_quote,
        max_usd_per_tx: max_usd,
        max_price_age: max_age,
    ) {
        Verdict::Deny(reason) => {
            match reason {
                DenyReason::PriceUnavailable => {},
                _ => assert(false),
            }
        },
        _ => assert(false),
    }

    let no_quote: Option<PriceQuote> = Option::None
    match decide_with_usd(
        tx: tx_eth,
        policy: pol,
        state,
        price_quote: no_quote,
        max_usd_per_tx: max_usd,
        max_price_age: max_age,
    ) {
        Verdict::Deny(reason) => {
            match reason {
                DenyReason::PriceUnavailable => {},
                _ => assert(false),
            }
        },
        _ => assert(false),
    }

    // 3. Attack: Exceeding USD cap ($12,000 spend > $10,000 cap) -> UsdCapExceeded (code 19)
    let fresh_quote = Option::Some(
        PriceQuote { usd_per_eth_1e8: 3000_00000000, updated_at: now_ts },
    )

    let tx_over_usd = Tx {
        to: treasury,
        value: ether(4) / 100,
        // 0.04 ETH = $120 > $100 cap
        data: Calldata::empty(),
        op: Operation::Call,
        now: now_ts,
    }

    match decide_with_usd(
        tx: tx_over_usd,
        policy: pol,
        state,
        price_quote: fresh_quote,
        max_usd_per_tx: 100_00000000,
        // $100 cap
        max_price_age: max_age,
    ) {
        Verdict::Deny(reason) => {
            match reason {
                DenyReason::UsdCapExceeded => {},
                _ => assert(false),
            }
        },
        _ => assert(false),
    }

    // 4. Honest transaction: 0.02 ETH * $3,000 = $60 <= $100 cap -> Allowed
    let tx_valid = Tx {
        to: treasury,
        value: ether(2) / 100,
        // 0.02 ETH = $60 <= $100 cap
        data: Calldata::empty(),
        op: Operation::Call,
        now: now_ts,
    }

    match decide_with_usd(
        tx: tx_valid,
        policy: pol,
        state,
        price_quote: fresh_quote,
        max_usd_per_tx: 100_00000000,
        max_price_age: max_age,
    ) {
        Verdict::Allow => {},
        _ => assert(false),
    }
}
