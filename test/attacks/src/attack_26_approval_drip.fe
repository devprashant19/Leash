use policy::{
    AgentState,
    Operation,
    Timestamp,
    Tx,
    Wei,
    decide,
    default_policy,
    record,
    verdict_code,
}
use testkit::{addr_attacker, addr_token, addr_treasury, erc20_approve, erc20_increase_allowance}

const TOKEN: u256 = 1_000_000_000_000_000_000

fn token_call(_ data: policy::Calldata, _ now: Timestamp) -> Tx {
    Tx { to: addr_token(), value: Wei::zero(), data, op: Operation::Call, now }
}

// Draining tokens through approvals: the agent approves an attacker for 100 tokens again and again,
// and the attacker pulls each allowance with transferFrom outside the module. Every approval is booked
// against the 500-token cap for the 24 h period, so the sixth one is refused (21).
#[test]
pub fn test_attack_26_approval_drip() {
    let pol = default_policy()
    var state = AgentState::empty()
    state.expiry = Timestamp::from_seconds(2_000_000_000)
    let now = Timestamp::from_seconds(1_763_000_000)

    var i: u32 = 0
    while i < 5 {
        let approval = token_call(
            erc20_approve(spender: addr_attacker(), amt: 100 * TOKEN),
            now,
        )
        assert(verdict_code(decide(approval, pol, state)) == 0)
        record(approval, pol, mut state)
        i += 1
    }
    assert(state.token_spent[0].amount == 500 * TOKEN)
    let sixth = token_call(
        erc20_approve(spender: addr_attacker(), amt: 100 * TOKEN),
        now,
    )
    assert(verdict_code(decide(sixth, pol, state)) == 21)
    // Transfers share the same cap: nothing is left for today.
    let transfer = token_call(erc20_transfer_one(), now)
    assert(verdict_code(decide(transfer, pol, state)) == 21)
}

fn erc20_transfer_one() -> policy::Calldata {
    testkit::erc20_transfer(to: addr_treasury(), amt: TOKEN)
}

// increaseAllowance grows an allowance instead of replacing it, so repeating it is the same drain.
// When a policy enables it, each call is booked like an approval.
#[test]
pub fn test_attack_26_increase_allowance_drip() {
    var pol = default_policy()
    pol.targets[0].selectors[3] = policy::SEL_INCREASE_ALLOWANCE
    pol.targets[0].n_selectors = 4
    var state = AgentState::empty()
    state.expiry = Timestamp::from_seconds(2_000_000_000)
    let now = Timestamp::from_seconds(1_763_000_000)

    var i: u32 = 0
    while i < 5 {
        let more = token_call(
            erc20_increase_allowance(spender: addr_attacker(), amt: 100 * TOKEN),
            now,
        )
        assert(verdict_code(decide(more, pol, state)) == 0)
        record(more, pol, mut state)
        i += 1
    }
    let sixth = token_call(
        erc20_increase_allowance(spender: addr_attacker(), amt: 100 * TOKEN),
        now,
    )
    assert(verdict_code(decide(sixth, pol, state)) == 21)
}
