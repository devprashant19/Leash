use std::evm::Address

pub msg GuardianMsg {
    #[selector = 0x8456cb59]
    Pause,
}

pub contract SecureModule {
    pub mut paused: bool,
    pub mut max_limit: u256,

    recv GuardianMsg {
        // The guardian endpoint only requests capability to mutate `paused`.
        // Attempting to mutate `max_limit` violates Fe's compile-time effect tracking.
        Pause uses (mut paused) {
            paused = true
            max_limit = 999999
        }
    }
}
