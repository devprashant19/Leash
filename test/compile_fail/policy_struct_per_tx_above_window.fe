// Demonstrates compile-time rejection of an invalid Policy struct where max_per_tx > max_per_window.
use std::evm::Address
use std::evm::units::{Duration, Wei, ether, hours}

pub struct TargetRule { pub target: Address, pub allow_eth_transfer: bool }

impl Copy for TargetRule {}
impl Snapshot for TargetRule {}

pub struct Policy {
    pub version: u8,
    pub n_targets: u8,
    pub targets: [TargetRule; 8],
    pub max_per_tx: Wei,
    pub max_per_window: Wei,
    pub window: Duration,
}

pub const fn validate_policy_invariants(pol: Policy) -> u32 {
    if pol.max_per_tx.as_wei() > pol.max_per_window.as_wei() {
        1 / 0
    } else {
        1
    }
}

pub const INVALID_POLICY: Policy = Policy {
    version: 1,
    n_targets: 1,
    targets: [TargetRule { target: Address::new(0), allow_eth_transfer: false }; 8],
    max_per_tx: ether(1),
    max_per_window: ether(1) / 2,
    window: hours(24),
}

pub const CHECK_INVALID: u32 = validate_policy_invariants(pol: INVALID_POLICY)
