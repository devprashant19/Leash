pub fn chunk_digest(_ idx: usize) -> u256 {
    if idx == 0 {
        CHUNK_DIGEST_0
    } else if idx == 1 {
        CHUNK_DIGEST_1
    } else if idx == 2 {
        CHUNK_DIGEST_2
    } else if idx == 3 {
        CHUNK_DIGEST_3
    } else if idx == 4 {
        CHUNK_DIGEST_4
    } else if idx == 5 {
        CHUNK_DIGEST_5
    } else if idx == 6 {
        CHUNK_DIGEST_6
    } else if idx == 7 {
        CHUNK_DIGEST_7
    } else if idx == 8 {
        CHUNK_DIGEST_8
    } else if idx == 9 {
        CHUNK_DIGEST_9
    } else {
        0
    }
}
