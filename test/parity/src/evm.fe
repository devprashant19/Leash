#[test]
pub fn test_parity_evm_final_combined() {
    var k = Keccak256::new()
    var i: usize = 0
    while i < 10 {
        let cd = chunk_digest(i)
        assert(cd != 0)
        k.update_word(cd, len: 32)
        i += 1
    }
    let final_digest = k.finish_word()
    assert(final_digest == PARITY_GOLDEN_DIGEST)
}
