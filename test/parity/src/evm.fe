use testkit::{
    CHUNK_DIGEST_0,
    CHUNK_DIGEST_1,
    CHUNK_DIGEST_2,
    CHUNK_DIGEST_3,
    CHUNK_DIGEST_4,
    CHUNK_DIGEST_5,
    CHUNK_DIGEST_6,
    CHUNK_DIGEST_7,
    CHUNK_DIGEST_8,
    CHUNK_DIGEST_9,
    PARITY_GOLDEN_DIGEST,
    chunk_digest,
    run_parity_chunk,
}
use core::hash::Keccak256

#[test]
pub fn test_parity_evm_chunk_0() {
    let d0 = run_parity_chunk(chunk_idx: 0, chunk_size: 1000)
    assert(d0 == CHUNK_DIGEST_0)
}

#[test]
pub fn test_parity_evm_chunk_1() {
    let d1 = run_parity_chunk(chunk_idx: 1, chunk_size: 1000)
    assert(d1 == CHUNK_DIGEST_1)
}

